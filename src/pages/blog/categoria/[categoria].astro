---
import BlogCategory from '../../../views/BlogCategory.astro';
import { getPosts } from '../../../data/posts.js';

export async function getStaticPaths() {
  // sólo categorías con artículos: una página vacía no aporta nada a quien llega ni a Google
  const used = new Set((await getPosts('es')).map((p) => p.data.category));
  return [...used].map((categoria) => ({ params: { categoria } }));
}
---

<BlogCategory slug={Astro.params.categoria} />
