---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import BlogBackground from '../../../components/blog/BlogBackground.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import { getPosts } from '../../../data/posts.js';
import { blogCategories } from '../../../data/blog.js';
import { site } from '../../../data/site.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  // sólo categorías con artículos: una página vacía no aporta nada a quien llega ni a Google
  return blogCategories
    .map((cat) => ({ cat, posts: posts.filter((p) => p.data.category === cat.slug) }))
    .filter(({ posts }) => posts.length > 0)
    .map(({ cat, posts }) => ({ params: { categoria: cat.slug }, props: { cat, posts } }));
}
const { cat, posts } = Astro.props;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Blog', item: `${site.url}/blog` },
  { '@type': 'ListItem', position: 2, name: cat.name, item: `${site.url}/blog/categoria/${cat.slug}` },
] }];
---

<Layout title={`${cat.name} · Blog · GrowLab`} description={cat.description} jsonld={jsonld}>
  <BlogBackground />
  <Nav />
  <main class="page-in relative z-[1]">
    <BlogList eyebrow="Blog · Categoría" title={cat.name} text={cat.description} current={cat.slug} />
  </main>
  <div class="relative z-[1]"><Footer seamless /></div>
</Layout>
