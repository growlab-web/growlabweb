---
// Artículo del blog: migas de pan, cabecera, portada, índice lateral, cuerpo, llamado a la acción y artículos relacionados.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BlogBackground from '../../components/blog/BlogBackground.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPosts } from '../../data/posts.js';
import { getCategory, formatDate, readingTime } from '../../data/blog.js';
import { services } from '../../data/services.js';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { title, description, date, updated, category, cover, coverAlt, author, tags } = post.data;
const { Content, headings } = await render(post);
const cat = getCategory(category);
const service = services.find((s) => s.slug === cat?.service);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);
const url = `${site.url}/blog/${post.id}`;

// relacionados: primero de la misma categoría, luego los más recientes
const others = posts.filter((p) => p.id !== post.id);
const related = [...others.filter((p) => p.data.category === category), ...others.filter((p) => p.data.category !== category)].slice(0, 3);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated || date).toISOString(),
    author: { '@type': author === 'GrowLab' ? 'Organization' : 'Person', name: author },
    publisher: { '@id': `${site.url}/#organizacion` },
    mainEntityOfPage: url,
    image: cover ? new URL(cover, site.url).href : `${site.url}/og.jpg`,
    articleSection: cat?.name,
    keywords: tags.join(', '),
    inLanguage: 'es-PE',
    wordCount: post.body?.trim().split(/\s+/).length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: `${site.url}/blog` },
      { '@type': 'ListItem', position: 2, name: cat?.name, item: `${site.url}/blog/categoria/${category}` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Layout title={`${title} · Blog · GrowLab`} description={description} image={cover || '/og.jpg'} type="article" published={date} modified={updated || date} jsonld={jsonld}>
  <BlogBackground />
  <Nav />
  <main class="page-in relative z-[1]">
    <article data-blog-post data-category={category} class="mx-auto max-w-[1180px] px-(--pad) pb-[10vh] pt-[clamp(120px,18vh,180px)]">
      <nav aria-label="Migas de pan" class="mb-8 font-ui text-[.85rem] text-white/55">
        <a href="/blog" id="blog-migas-blog" class="transition-colors hover:text-secondary">Blog</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href={`/blog/categoria/${category}`} id="blog-migas-categoria" class="transition-colors hover:text-secondary">{cat?.name}</a>
      </nav>

      <header class="max-w-[860px]">
        <h1 class="font-display text-[clamp(2rem,4vw,3.6rem)] font-medium leading-[1.06] tracking-[-0.03em]">{title}</h1>
        <p class="mt-6 max-w-[60ch] font-body text-[clamp(1rem,1.25vw,1.2rem)] leading-relaxed text-copy">{description}</p>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-ui text-[.85rem] text-white/55">
          <span class="text-white/85">{author}</span>
          <span aria-hidden="true">·</span><time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <><span aria-hidden="true">·</span><span>Actualizado el <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span></>}
          <span aria-hidden="true">·</span><span>{minutes} min de lectura</span>
        </p>
      </header>

      {cover && (
        <figure class="mt-10 overflow-hidden rounded-[24px] border border-white/10">
          <img src={cover} alt={coverAlt || title} loading="eager" fetchpriority="high" decoding="async" class="block aspect-[16/9] w-full object-cover" />
        </figure>
      )}

      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_260px]">
        <div class="prose-blog min-w-0 max-w-[720px]">
          <Content />
        </div>

        {toc.length > 1 && (
          <aside class="max-lg:order-first">
            <nav aria-label="Índice del artículo" class="rounded-[20px] border border-white/10 bg-panel/70 p-5 lg:sticky lg:top-[100px]">
              <p class="mb-3 font-display text-[.74rem] uppercase tracking-[.16em] text-white/50">En este artículo</p>
              <ol class="grid gap-2.5 font-ui text-[.9rem]">
                {toc.map((h) => <li><a href={`#${h.slug}`} class="text-white/75 transition-colors hover:text-secondary">{h.text}</a></li>)}
              </ol>
            </nav>
          </aside>
        )}
      </div>

      {tags.length > 0 && (
        <p class="mt-10 flex max-w-[720px] flex-wrap gap-2">{tags.map((t) => <span class="rounded-full border border-white/15 px-3 py-1 font-ui text-[.8rem] text-white/60">#{t}</span>)}</p>
      )}

      <!-- llamado a la acción: el servicio relacionado con la categoría -->
      <aside class="mt-14 max-w-[860px] rounded-[24px] border border-secondary/40 bg-[linear-gradient(135deg,rgba(109,242,192,.10),rgba(56,111,222,.10))] p-[clamp(1.5rem,3.5vw,2.5rem)]">
        <p class="eyebrow">{service ? service.name : '¿Hablamos?'}</p>
        <p class="font-display text-[clamp(1.4rem,2.4vw,2rem)] font-medium leading-[1.15] tracking-[-0.02em]">¿Quieres aplicar esto en tu negocio?</p>
        <p class="mt-3 max-w-[56ch] text-copy">{service ? service.short : 'Cuéntanos qué quieres lograr y te proponemos un plan.'}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contacto" id="blog-cta-agendar" class="gtm-boton gtm-agendar btn">Agendar reunión</a>
          <a href={site.whatsapp.href} id="blog-cta-whatsapp" target="_blank" rel="noopener noreferrer" class="gtm-boton gtm-whatsapp inline-flex items-center rounded-full border border-white/30 px-7 py-4 font-display font-medium transition-colors hover:border-white">Escríbenos por WhatsApp</a>
        </div>
      </aside>
    </article>

    {related.length > 0 && (
      <section class="mx-auto max-w-[1180px] px-(--pad) pb-[12vh]">
        <h2 class="mb-8 font-display text-[clamp(1.4rem,2.4vw,2rem)] font-medium tracking-[-0.02em]">Sigue leyendo</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </main>
  <div class="relative z-[1]"><Footer seamless /></div>
</Layout>

<script>
  import { trackOnce } from '../../scripts/track.js';
  // medición: cuánto se lee el artículo (50 % y 90 % del cuerpo)
  const body = document.querySelector('.prose-blog');
  const art = document.querySelector('[data-blog-post]');
  if (body && art) {
    const slug = location.pathname.split('/').pop();
    const check = () => {
      const r = body.getBoundingClientRect(), seen = (innerHeight - r.top) / r.height;
      if (seen >= 0.5) trackOnce('blog50', 'blog_read', { article: slug, category: art.dataset.category, percent: 50 });
      if (seen >= 0.9) { trackOnce('blog90', 'blog_read', { article: slug, category: art.dataset.category, percent: 90 }); removeEventListener('scroll', check); }
    };
    addEventListener('scroll', check, { passive: true });
  }
</script>
