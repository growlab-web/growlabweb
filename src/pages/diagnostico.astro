---
// Landing del diagnóstico gratuito: un aviso invita a seguir a @lab.grow en Instagram (no es obligatorio), la persona deja sus datos y, al enviarlos, elige día y hora
// en la agenda (Calendly) que aparece dentro de la misma página. El envío usa el mismo /api/contacto.php que el formulario de
// contacto (el lead llega por correo y queda en leads.csv); los datos propios del diagnóstico viajan en el mensaje.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { countries } from '../data/countries.js';

const areas = ['Campañas de anuncios', 'Web o tienda online', 'SEO', 'Redes sociales', 'Medición y tracking'];
const budgets = ['Aún no invierto en anuncios', 'Menos de US$300 al mes', 'US$300 – 1 000 al mes', 'US$1 000 – 5 000 al mes', 'Más de US$5 000 al mes'];
const includes = [
  { t: 'Tu web o tienda', d: 'Velocidad, experiencia en celular y los puntos donde se pierden ventas o contactos.' },
  { t: 'Tus campañas', d: 'Estructura, segmentación y gasto en Meta Ads y Google Ads: qué funciona y qué está desperdiciando presupuesto.' },
  { t: 'Tu medición', d: 'GA4, Tag Manager, píxeles y conversiones: si los números que ves son fiables.' },
  { t: 'Un plan de acción', d: 'Las 3 mejoras que más impacto tendrían en tu negocio, ordenadas por prioridad.' },
];
const faqs = [
  { q: '¿Tiene algún costo?', a: 'No. El diagnóstico y la videollamada son gratuitos y sin compromiso: si después quieres que te ayudemos, te preparamos una propuesta; si no, te quedas con las recomendaciones.' },
  { q: '¿Por qué seguirlos en Instagram?', a: `En @${site.instagram.user} compartimos consejos, casos y novedades de marketing digital. Es la mejor forma de seguir aprendiendo después del diagnóstico.` },
  { q: '¿Cuánto dura y cómo es?', a: 'Es una videollamada de 30 minutos. Antes revisamos lo que nos indiques en el formulario y en la llamada te mostramos lo que encontramos y qué mejorar primero.' },
  { q: '¿Qué necesito tener?', a: 'Una web, una tienda online o campañas activas que podamos revisar. Si estás empezando, también te orientamos sobre por dónde comenzar.' },
];
const wrap = 'group relative flex items-center gap-3 border-b border-white/20 transition-colors focus-within:border-secondary';
const input = 'w-full bg-transparent py-4 font-body text-[1rem] text-white outline-none placeholder:text-white/40';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diagnóstico gratuito de marketing digital',
    provider: { '@id': `${site.url}/#organizacion` },
    areaServed: [{ '@type': 'Country', name: 'Perú' }, { '@type': 'Place', name: 'Todo el mundo' }],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN', availability: 'https://schema.org/InStock', url: `${site.url}/diagnostico` },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout
  title="Diagnóstico gratuito de marketing digital | GrowLab"
  description="Revisamos gratis tu web, tus campañas y tu medición, y en una videollamada de 30 minutos te mostramos qué mejorar primero. Agenda tu diagnóstico."
  jsonld={jsonld}
>
  <Nav />
  <main id="contenido" tabindex="-1" class="page-in">
    <section class="relative overflow-hidden bg-[linear-gradient(175deg,#030814_0%,#000_55%,#000_100%)]">
      <div class="pointer-events-none absolute -left-[16vw] -top-[10vw] h-[30vw] w-[62vw] rotate-[-16deg] opacity-45 blur-[80px] max-sm:h-[80vw] max-sm:w-[130vw]" aria-hidden="true">
        <i class="aurora-blob aurora-blob--a bg-[radial-gradient(closest-side,#386fde,#1d3f94_55%,transparent)]"></i>
      </div>
      <div class="pointer-events-none absolute -right-[14vw] top-[30%] h-[26vw] w-[60vw] opacity-25 blur-[90px] max-sm:h-[70vw] max-sm:w-[120vw]" aria-hidden="true">
        <i class="aurora-blob aurora-blob--b bg-[radial-gradient(closest-side,#6df2c0,#1f8f68_55%,transparent)]"></i>
      </div>
      <canvas data-dust class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

      <div class="relative z-[1] mx-auto max-w-[1080px] px-(--pad) pb-[10vh] pt-[clamp(130px,20vh,200px)]">
        <!-- cabecera -->
        <header class="mx-auto max-w-[820px] text-center">
          <p data-reveal class="eyebrow">Diagnóstico gratuito</p>
          <h1 data-reveal class="display-xl !text-[clamp(2.2rem,4.6vw,4.8rem)]">Descubre qué está frenando tus ventas online.</h1>
          <p data-reveal class="mx-auto mt-7 max-w-[56ch] font-body text-[clamp(1rem,1.2vw,1.15rem)] leading-relaxed text-copy">
            Revisamos tu web, tus campañas y tu medición, y en una videollamada de 30 minutos te mostramos qué mejorar primero. Sin costo y sin compromiso.
          </p>
          <a data-reveal href="#solicitar" id="diagnostico-empezar" class="gtm-boton btn mt-9">Quiero mi diagnóstico</a>
        </header>

        <!-- qué incluye -->
        <div class="mt-[clamp(4rem,10vh,7rem)]">
          <h2 data-reveal class="text-center font-display text-[clamp(1.5rem,2.6vw,2.2rem)] font-medium tracking-[-0.02em]">Qué revisamos</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {includes.map((it, i) => (
              <div data-reveal class="rounded-[22px] border border-white/10 bg-panel/70 p-6">
                <p class="font-display text-[.8rem] tracking-[.16em] text-secondary">0{i + 1}</p>
                <h3 class="mt-3 font-display text-[1.15rem] font-medium">{it.t}</h3>
                <p class="mt-2 font-body text-[.95rem] leading-relaxed text-copy">{it.d}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- pasos + formulario -->
        <div id="solicitar" class="mt-[clamp(4rem,10vh,7rem)] scroll-mt-[90px]">
          <h2 data-reveal class="text-center font-display text-[clamp(1.5rem,2.6vw,2.2rem)] font-medium tracking-[-0.02em]">Solicítalo en 3 pasos</h2>
          <ol data-reveal class="mx-auto mt-8 grid max-w-[860px] gap-3 font-body text-[.95rem] text-copy sm:grid-cols-3">
            <li class="dg-step"><b>1</b>Cuéntanos sobre tu negocio</li>
            <li class="dg-step"><b>2</b>Elige el día y la hora de la videollamada</li>
            <li class="dg-step"><b>3</b>Recibe tu diagnóstico y un plan de acción</li>
          </ol>

          <div data-reveal class="relative z-[2] mx-auto mt-10 max-w-[860px] rounded-[26px] border border-white/10 bg-[#070b16]/80 p-[clamp(1.4rem,4vw,2.8rem)] backdrop-blur-sm">
            <form id="form-diagnostico" data-diag-form data-email={site.email} class="grid gap-x-10 gap-y-7 sm:grid-cols-2" novalidate>
              <!-- aviso: seguirnos en Instagram (opcional, no condiciona el envío) -->
              <div class="flex flex-wrap items-center justify-between gap-4 rounded-[18px] border border-[#ff8fd0]/30 bg-[linear-gradient(120deg,rgba(255,143,208,.08),rgba(182,156,255,.08))] p-5 sm:col-span-2">
                <p class="font-body text-[.95rem] text-copy">Síguenos en Instagram: compartimos consejos, casos y novedades de marketing digital.</p>
                <a href={site.instagram.href} id="diagnostico-seguir-instagram" data-ig-follow target="_blank" rel="noopener noreferrer" class="gtm-boton inline-flex items-center gap-2.5 rounded-full bg-[linear-gradient(90deg,#f58529,#dd2a7b,#8134af)] px-5 py-3 font-display text-[.92rem] font-medium text-white transition-transform hover:scale-[1.03]">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
                  Seguir a @{site.instagram.user}
                </a>
              </div>

              <label class={wrap}>
                <span class="sr-only">Nombre</span>
                <input class={input} name="nombre" type="text" placeholder="Nombre *" autocomplete="name" required aria-required="true" />
              </label>
              <label class={wrap}>
                <span class="sr-only">Email</span>
                <input class={input} name="email" type="email" placeholder="Email *" autocomplete="email" required aria-required="true" />
              </label>
              <div class={wrap}>
                <span class="relative flex shrink-0 items-center gap-1.5 py-4 font-body text-[1rem] text-white">
                  <span data-prefix-label>+51</span>
                  <svg class="h-3.5 w-3.5 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  <select name="prefijo" id="diagnostico-prefijo" data-prefix aria-label="País del teléfono" autocomplete="tel-country-code" class="absolute inset-0 h-full w-full cursor-pointer bg-[#0b1226] text-white opacity-0">
                    {countries.map(([name, code], i) => <option value={code} selected={i === 0}>{name} ({code})</option>)}
                  </select>
                </span>
                <i class="h-5 w-px shrink-0 bg-white/20" aria-hidden="true"></i>
                <label class="flex-1">
                  <span class="sr-only">Teléfono o WhatsApp</span>
                  <input class={input} name="telefono" type="tel" inputmode="tel" placeholder="Teléfono o WhatsApp *" autocomplete="tel-national" required aria-required="true" />
                </label>
              </div>
              <label class={wrap}>
                <span class="sr-only">Web, tienda o red que quieres que revisemos</span>
                <input class={input} name="web" type="text" inputmode="url" placeholder="Web o red a revisar (opcional)" autocomplete="url" />
              </label>

              <fieldset class="sm:col-span-2">
                <legend class="mb-3 font-body text-[.95rem] text-white/60">¿Qué quieres que revisemos?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {areas.map((a, i) => (
                    <label class="dg-chip"><input type="checkbox" name="areas" value={a} id={`diagnostico-area-${i + 1}`} class="sr-only" /><span>{a}</span></label>
                  ))}
                </div>
              </fieldset>

              <label class={wrap + ' sm:col-span-2'}>
                <span class="sr-only">Inversión mensual en anuncios</span>
                <select name="inversion" id="diagnostico-inversion" class={input + ' cursor-pointer appearance-none bg-transparent [&>option]:bg-[#0b1226]'}>
                  <option value="">Inversión mensual en anuncios (opcional)</option>
                  {budgets.map((b) => <option value={b}>{b}</option>)}
                </select>
                <svg class="pointer-events-none h-4 w-4 shrink-0 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </label>

              <label class={wrap + ' items-start sm:col-span-2'}>
                <span class="sr-only">Comentario</span>
                <textarea class={input + ' min-h-[90px] resize-none'} name="mensaje" placeholder="¿Algo que debamos saber? (opcional)"></textarea>
              </label>

              <!-- campo trampa para robots -->
              <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
                <label>No rellenes este campo <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="grid gap-3 sm:col-span-2">
                <label class="flex cursor-pointer items-start gap-3 font-body text-[.92rem] text-white/70">
                  <input type="checkbox" name="consent" class="mt-0.5 h-[18px] w-[18px] shrink-0 cursor-pointer accent-secondary" />
                  <span>Acepto que se recopilen mis datos según la <a href={site.privacy.href} id="diagnostico-privacidad" target="_blank" class="underline underline-offset-2 transition-colors hover:text-secondary">política de privacidad</a>.</span>
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-x-8 gap-y-4 sm:col-span-2">
                <button type="submit" id="diagnostico-enviar" data-diag-submit class="gtm-boton gtm-enviar inline-flex h-[54px] cursor-pointer items-center gap-3 bg-secondary px-8 font-display text-[.85rem] font-semibold uppercase tracking-[.12em] text-black transition-colors hover:bg-white disabled:cursor-wait disabled:opacity-60">
                  Continuar y elegir fecha →
                </button>
              </div>
              <p data-diag-note class="min-h-[1.4em] font-body text-[.88rem] text-muted sm:col-span-2" role="status" aria-live="polite"></p>
            </form>

            <!-- paso 3: agenda dentro de la página (aparece al enviar el formulario) -->
            <div data-diag-agenda hidden class="scroll-mt-[96px]">
              <div role="status" aria-live="polite" class="text-center">
                <p data-diag-test hidden class="mx-auto mb-5 w-fit rounded-full border border-[#ffcf7a]/50 px-4 py-1.5 font-ui text-[.78rem] text-[#ffcf7a]">Modo de prueba: aquí no se envía ningún correo</p>
                <h2 class="font-display text-[clamp(1.6rem,3vw,2.5rem)] font-medium leading-[1.06] tracking-[-0.03em] text-secondary">¡Listo<span data-diag-name></span>! Último paso</h2>
                <p class="mx-auto mt-3 max-w-[48ch] font-body text-copy">Elige el día y la hora de tu videollamada de 30 minutos. Te llegará la confirmación por correo.</p>
              </div>
              <div data-calendly data-url={site.calendlyDiagnostico} class="relative mx-auto mt-7 min-h-[700px] overflow-hidden rounded-[22px] border border-white/10 bg-white/[.03]">
                <p data-calendly-wait class="absolute inset-x-0 top-1/2 -translate-y-1/2 px-6 text-center font-body text-copy">
                  Cargando la agenda… Si no aparece, <a id="diagnostico-calendly-externo" href={site.calendlyDiagnostico} target="_blank" rel="noopener noreferrer" class="text-secondary underline underline-offset-4">ábrela en Calendly</a>.
                </p>
              </div>
              <p data-diag-done hidden class="mx-auto mt-6 max-w-[52ch] text-center font-body text-white">✅ ¡Reunión agendada! Revisa tu correo: ahí tienes la confirmación y el enlace de la videollamada.</p>
            </div>
          </div>
        </div>

        <!-- preguntas frecuentes -->
        <div class="mx-auto mt-[clamp(4rem,10vh,7rem)] max-w-[860px]">
          <h2 data-reveal class="text-center font-display text-[clamp(1.5rem,2.6vw,2.2rem)] font-medium tracking-[-0.02em]">Preguntas frecuentes</h2>
          <div class="mt-8 grid gap-3">
            {faqs.map((f, i) => (
              <details data-reveal class="dg-faq rounded-[18px] border border-white/10 bg-panel/60 px-6 py-5">
                <summary id={`diagnostico-pregunta-${i + 1}`} class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[1.05rem]">{f.q}<span class="dg-faq__arrow text-secondary" aria-hidden="true">+</span></summary>
                <p class="mt-3 font-body leading-relaxed text-copy">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .dg-step { display: flex; align-items: center; gap: .8rem; border: 1px solid rgba(255, 255, 255, .1); border-radius: 18px; padding: 1rem 1.1rem; background: rgba(255, 255, 255, .03); }
  .dg-step b { display: grid; place-items: center; width: 2rem; height: 2rem; flex: none; border-radius: 50%; background: var(--color-secondary); color: #000; font-family: var(--font-display); font-weight: 600; }
  .dg-chip span { display: inline-flex; align-items: center; border: 1px solid rgba(255, 255, 255, .2); border-radius: 9999px; padding: .6rem 1.1rem; font-size: .9rem; color: rgba(255, 255, 255, .8); cursor: pointer; transition: background-color .25s, border-color .25s, color .25s; }
  .dg-chip span:hover { border-color: #fff; }
  .dg-chip input:checked + span { background: var(--color-secondary); border-color: var(--color-secondary); color: #000; }
  .dg-chip input:focus-visible + span { outline: 2px solid var(--color-secondary); outline-offset: 3px; }
  .dg-faq[open] .dg-faq__arrow { transform: rotate(45deg); }
  .dg-faq__arrow { font-size: 1.4rem; line-height: 1; transition: transform .25s; }
</style>

<script>
  import { track } from '../scripts/track.js';

  const form = document.querySelector<HTMLFormElement>('[data-diag-form]');
  const agenda = document.querySelector<HTMLElement>('[data-diag-agenda]');
  if (form && agenda) {
    const note = form.querySelector<HTMLElement>('[data-diag-note]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-diag-submit]')!;
    const say = (msg: string, kind?: string) => { note.textContent = msg; note.style.color = kind === 'error' ? '#ff9a9a' : ''; };

    // prefijo del teléfono: se ve el código del país elegido
    const prefix = form.querySelector<HTMLSelectElement>('[data-prefix]'), prefixLabel = form.querySelector('[data-prefix-label]');
    const paintPrefix = () => { if (prefix && prefixLabel) prefixLabel.textContent = prefix.value; };
    prefix?.addEventListener('change', paintPrefix);

    // aviso: clic en «Seguir a @lab.grow» (abre Instagram en otra pestaña)
    form.querySelector('[data-ig-follow]')?.addEventListener('click', () => track('ig_follow_click', { form_location: 'diagnostico' }));
    form.addEventListener('focusin', () => track('form_start', { form_location: 'diagnostico' }), { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const get = (k: string) => String(f.get(k) || '').trim();
      const nombre = get('nombre'), email = get('email'), telefono = get('telefono');
      const areas = f.getAll('areas').map(String);
      // obligatorios: nombre, correo, teléfono y el consentimiento
      const missing = [
        !nombre && 'tu nombre',
        !/^\S+@\S+\.\S+$/.test(email) && 'un correo válido',
        telefono.replace(/\D/g, '').length < 6 && 'un teléfono válido',
      ].filter(Boolean) as string[];
      if (missing.length) return say(`Completa ${missing.join(missing.length > 2 ? ', ' : ' y ').replace(/, ([^,]*)$/, ' y $1')}.`, 'error');
      if (!f.get('consent')) return say('Para continuar debes aceptar que se recopilen tus datos.', 'error');

      const phone = telefono.startsWith('+') ? telefono : `${get('prefijo')} ${telefono}`.trim();
      // al servidor van los mismos campos que el formulario de contacto; lo propio del diagnóstico, dentro del mensaje
      const out = new FormData();
      out.set('nombre', nombre); out.set('email', email); out.set('telefono', phone); out.set('consent', '1'); out.set('website', get('website'));
      out.set('pagina', location.href);
      ['Diagnóstico gratuito', ...areas].forEach((s) => out.append('servicios[]', s));
      out.set('mensaje', [
        'Solicitud: DIAGNÓSTICO GRATUITO',
        `Web o red a revisar: ${get('web') || '-'}`,
        `Qué revisar: ${areas.join(', ') || '-'}`,
        `Inversión mensual en anuncios: ${get('inversion') || '-'}`,
        `Comentario: ${get('mensaje') || '-'}`,
      ].join('\n'));

      button.disabled = true; say('Enviando…');
      let result: { ok: boolean; error?: string } | null = null;
      try {
        const res = await fetch('/api/contacto.php', { method: 'POST', body: out, headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (data && typeof data.ok === 'boolean') result = data;
      } catch (err) { /* sin servidor: ver modo de prueba abajo */ }
      button.disabled = false;

      const test = !result && (['localhost', '127.0.0.1'].includes(location.hostname) || location.hostname.endsWith('.vercel.app'));
      if (result && !result.ok) return say(result.error || 'No pudimos enviar tus datos. Inténtalo de nuevo.', 'error');
      if (!result && !test) return say(`No pudimos enviar tus datos. Inténtalo de nuevo en unos minutos o escríbenos a ${form.dataset.email}.`, 'error');

      if (result) {
        track('generate_lead', {
          form_location: 'diagnostico', lead_method: 'diagnostico',
          lead_service_primary: areas[0] || 'Diagnóstico gratuito', lead_services: ['Diagnóstico gratuito', ...areas].join(', '), lead_services_count: areas.length,
          // sólo para conversiones mejoradas (Google Ads / Meta); no se envía a GA4, ver scripts/track.js
          user_data: { email: email.toLowerCase(), phone_number: '+' + phone.replace(/\D/g, '') },
        });
        (areas.length ? areas : ['Diagnóstico gratuito']).forEach((s) => track('lead_service', { lead_service: s, form_location: 'diagnostico' }));
      }
      showAgenda(nombre, email, test);
    });

    // paso 3: la agenda aparece en lugar del formulario, con el nombre y el correo ya escritos
    let frame: HTMLIFrameElement | null = null;
    function showAgenda(nombre: string, email: string, test: boolean) {
      form!.hidden = true; agenda!.hidden = false; say('');
      const first = nombre.split(/\s+/)[0];
      agenda!.querySelector('[data-diag-name]')!.textContent = first ? `, ${first}` : '';
      if (test) agenda!.querySelector<HTMLElement>('[data-diag-test]')!.hidden = false;
      const box = agenda!.querySelector<HTMLElement>('[data-calendly]')!;
      if (!frame) {
        const url = new URL(box.dataset.url || '');
        Object.entries({ embed_domain: location.hostname, embed_type: 'Inline', hide_gdpr_banner: '1', background_color: '0b0f1a', text_color: 'ffffff', primary_color: '6df2c0', name: nombre, email })
          .forEach(([k, v]) => { if (v) url.searchParams.set(k, v); });
        frame = document.createElement('iframe');
        frame.src = url.href; frame.title = 'Agenda tu diagnóstico gratuito con GrowLab'; frame.allow = 'payment';
        frame.style.cssText = 'position:relative;z-index:1;display:block;width:100%;height:700px;border:0';
        box.append(frame);
      }
      agenda!.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    // medición de la agenda: Calendly avisa con mensajes «calendly.*»
    addEventListener('message', (e) => {
      if (!frame || e.source !== frame.contentWindow || e.origin !== 'https://calendly.com' || !e.data || typeof e.data.event !== 'string') return;
      const box = agenda.querySelector<HTMLElement>('[data-calendly]')!;
      box.querySelector('[data-calendly-wait]')?.remove();
      const ev = e.data.event;
      if (ev === 'calendly.page_height') { const h = parseInt(e.data.payload && e.data.payload.height, 10); if (h > 300) frame.style.height = h + 'px'; }
      if (ev === 'calendly.date_and_time_selected') track('schedule_start', { form_location: 'diagnostico' });
      if (ev === 'calendly.event_scheduled') { track('meeting_scheduled', { form_location: 'diagnostico' }); agenda.querySelector<HTMLElement>('[data-diag-done]')!.hidden = false; }
    });
  }
</script>
