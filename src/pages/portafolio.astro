---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Cases from '../components/Cases.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Portafolio · GrowLab Agencia Digital"
  description="Casos de éxito de GrowLab: resultados reales en e-commerce, SaaS y restauración."
>
  <Nav />
  <main class="page-in">
    <PageHero
      shape="sphere"
      eyebrow="Portafolio"
      lines={['Resultados,', 'no promesas.']}
      text="Una selección de proyectos donde los datos y la creatividad se tradujeron en ventas."
    />
    <Cases />
    <Cta />
  </main>
  <Footer />
</Layout>
