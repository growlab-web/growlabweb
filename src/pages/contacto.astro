---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Contacto · GrowLab Agencia Digital"
  description="Cuéntanos tu proyecto. Te respondemos en menos de 24 horas laborables."
>
  <Nav />
  <main class="page-in">
    <PageHero
      compact
      shape="tracking"
      eyebrow="Contacto"
      lines={['Hablemos de tu', 'próximo proyecto.']}
      text="Cuéntanos qué quieres lograr. Revisamos tu caso y te respondemos en menos de 24 horas laborables con una propuesta clara."
    />

    <ContactSection />

    <section class="grid gap-10 border-t border-white/10 px-(--pad) py-[9vh] sm:grid-cols-3">
      <div data-reveal>
        <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="mail" size={18} class="text-secondary" />Correo</p>
        <a class="font-display text-[1.3rem] transition-colors hover:text-secondary" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div data-reveal>
        <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="clock" size={18} class="text-secondary" />Horario</p>
        <p class="text-muted">Lunes a viernes, 9:00 – 18:00</p>
      </div>
      <div data-reveal>
        <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="share-2" size={18} class="text-secondary" />Síguenos</p>
        <p class="flex flex-wrap gap-x-5 gap-y-1 text-muted">
          {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-secondary">{s.label}</a>)}
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
