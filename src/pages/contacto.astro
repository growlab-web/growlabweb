---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import Icon from '../components/Icon.astro';
import { gtmId } from '../data/gtm.js';
---

<Layout
  title="Contacto: agenda una reunión | GrowLab, Arequipa"
  description="Cuéntanos tu proyecto de marketing digital y agenda una reunión. Desde Arequipa atendemos a empresas de todo el Perú y del extranjero."
>
  <Nav />
  <main id="contenido" tabindex="-1" class="page-in">
    <!-- Una sola sección con un único fondo: título y descripción al centro, formulario y datos de contacto debajo -->
    <section class="relative overflow-hidden bg-[linear-gradient(175deg,#030814_0%,#000_55%,#000_100%)]">
      <div class="pointer-events-none absolute -left-[16vw] -top-[10vw] h-[30vw] w-[62vw] rotate-[-16deg] opacity-45 blur-[80px] max-sm:h-[80vw] max-sm:w-[130vw]" aria-hidden="true">
        <i class="aurora-blob aurora-blob--a bg-[radial-gradient(closest-side,#386fde,#1d3f94_55%,transparent)]"></i>
      </div>
      <div class="pointer-events-none absolute -right-[14vw] top-[38%] h-[26vw] w-[60vw] opacity-20 blur-[90px] max-sm:h-[70vw] max-sm:w-[120vw]" aria-hidden="true">
        <i class="aurora-blob aurora-blob--b bg-[radial-gradient(closest-side,#6df2c0,#1f8f68_55%,transparent)]"></i>
      </div>

      <canvas data-dust class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

      <div class="relative z-[1] mx-auto max-w-[960px] px-(--pad) pb-[10vh] pt-[clamp(130px,20vh,210px)]">
        <header class="mb-[clamp(3rem,8vh,5.5rem)] text-center">
          <p data-reveal class="eyebrow">¿Tomamos un café?</p>
          <h1 data-reveal class="display-xl !text-[clamp(2.2rem,4.4vw,4.8rem)]">
            <span class="block">Hablemos de tu</span>
            <span class="block">próximo proyecto.</span>
          </h1>
          <p data-reveal class="mx-auto mt-8 max-w-[52ch] font-body text-[clamp(.95rem,1.15vw,1.1rem)] leading-relaxed text-copy">
            Agenda una videollamada de 30 minutos en el horario que te acomode, o cuéntanos qué quieres lograr y te respondemos en menos de 24 horas laborables.
          </p>
        </header>

        <!-- dos formas de contactar: agendar directamente (Calendly) o escribir un mensaje. /contacto#mensaje abre la segunda -->
        <div data-reveal data-contact-tabs class="relative z-[2]">
          <div role="tablist" aria-label="Cómo quieres contactarnos" class="mx-auto mb-[clamp(2rem,5vh,3rem)] flex w-fit max-w-full gap-1 rounded-full border border-white/15 bg-white/[.03] p-1 font-display text-[.95rem]">
            <button type="button" role="tab" id="contacto-tab-agenda" data-tab="agenda" aria-controls="agenda" aria-selected="true" class="contact-tab gtm-boton">Agendar reunión</button>
            <button type="button" role="tab" id="contacto-tab-mensaje" data-tab="mensaje" aria-controls="mensaje" aria-selected="false" tabindex="-1" class="contact-tab gtm-boton">Escribir mensaje</button>
          </div>

          <div id="agenda" role="tabpanel" aria-labelledby="contacto-tab-agenda" class="scroll-mt-[100px]">
            <div data-calendly data-url={site.calendly} class="relative mx-auto min-h-[700px] max-w-[1000px] overflow-hidden rounded-[22px] border border-white/10 bg-white/[.03]">
              <!-- mientras carga (o si no carga) -->
              <p data-calendly-wait class="absolute inset-x-0 top-1/2 -translate-y-1/2 px-6 text-center font-body text-copy">
                Cargando la agenda… Si no aparece, <a id="contacto-calendly-externo" href={site.calendly} target="_blank" rel="noopener noreferrer" class="text-secondary underline underline-offset-4">ábrela en Calendly</a>.
              </p>
            </div>
          </div>

          <div id="mensaje" role="tabpanel" aria-labelledby="contacto-tab-mensaje" hidden class="scroll-mt-[100px]">
            <ContactForm />
          </div>
        </div>

        <!-- datos de contacto: una sola fila en escritorio (cada bloque ocupa lo que mide su texto), dos columnas en tablet y una en celular -->
        <div class="mt-[8vh] grid gap-x-8 gap-y-10 border-t border-white/10 pt-[6vh] sm:grid-cols-2 lg:flex lg:justify-between">
          <div data-reveal>
            <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="mail" size={18} class="text-secondary" />Correo</p>
            <a id="contacto-correo" class="font-display text-[1rem] break-words transition-colors hover:text-secondary lg:whitespace-nowrap" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div data-reveal>
            <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="phone" size={18} class="text-secondary" />Teléfono</p>
            <a id="contacto-telefono" class="font-display text-[1rem] whitespace-nowrap transition-colors hover:text-secondary" href={site.phone.href}>{site.phone.label}</a>
          </div>
          <div data-reveal>
            <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="clock" size={18} class="text-secondary" />Horario</p>
            <p class="text-muted lg:whitespace-nowrap">Lunes a viernes, 9:00 – 18:00</p>
          </div>
          <div data-reveal>
            <p class="mb-3 flex items-center gap-2 font-display text-[.78rem] uppercase tracking-[.14em] text-white/50"><Icon name="share-2" size={18} class="text-secondary" />Síguenos</p>
            <p class="flex flex-wrap gap-x-5 gap-y-1 text-muted">
              {site.social.map((s) => <a href={s.href} id={`contacto-${gtmId(s.label)}`} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-secondary">{s.label}</a>)}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-tab { border-radius: 9999px; padding: .7rem 1.4rem; color: rgba(255, 255, 255, .75); transition: background-color .3s, color .3s; cursor: pointer; white-space: nowrap; }
  .contact-tab:hover { color: #fff; }
  .contact-tab[aria-selected='true'] { background: var(--color-secondary); color: #000; }
  @media (max-width: 400px) { .contact-tab { padding: .65rem 1rem; font-size: .88rem; } }
</style>

<script>
  import { track } from '../scripts/track.js';

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-contact-tabs] [role=tab]')];
  const box = document.querySelector<HTMLElement>('[data-calendly]');

  // la agenda (Calendly) se carga cuando la página ya terminó de cargar: no retrasa el resto
  let loaded = false;
  function loadCalendly() {
    if (loaded || !box) return;
    loaded = true;
    const url = new URL(box.dataset.url || '');
    // embed_domain hace que Calendly avise a esta página de lo que pasa dentro (fecha elegida, reunión agendada, alto)
    Object.entries({ embed_domain: location.hostname, embed_type: 'Inline', hide_gdpr_banner: '1', background_color: '0b0f1a', text_color: 'ffffff', primary_color: '6df2c0' })
      .forEach(([k, v]) => url.searchParams.set(k, v));
    const frame = document.createElement('iframe');
    frame.src = url.href; frame.title = 'Agenda una reunión con GrowLab'; frame.allow = 'payment';
    frame.style.cssText = 'display:block;width:100%;height:700px;border:0';      // el marco se crea aquí: los estilos de la página no le llegan
    frame.addEventListener('load', () => box.querySelector('[data-calendly-wait]')?.remove());
    box.append(frame);
  }

  function select(name: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !on;
      if (on && focus) t.focus();
    });
    if (name === 'agenda') loadCalendly();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.tab || 'agenda'));
    // flechas izquierda / derecha entre pestañas (como en cualquier grupo de pestañas accesible)
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next.dataset.tab || 'agenda', true);
    });
  });

  // /contacto#mensaje abre directamente el formulario (el ancla la guarda Layout.astro en __glHash al cargar)
  const hash = (window as any).__glHash || location.hash;
  const start = hash === '#mensaje' ? 'mensaje' : 'agenda';
  if (start === 'mensaje') select('mensaje');
  else if (document.readyState === 'complete') loadCalendly();
  else addEventListener('load', () => setTimeout(loadCalendly, 300), { once: true });

  // medición de la agenda: Calendly avisa con mensajes «calendly.*»
  addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com' || !e.data || typeof e.data.event !== 'string') return;
    const ev = e.data.event;
    if (ev === 'calendly.page_height' && box) {          // la agenda crece o se encoge según el paso: el marco la sigue, sin scroll interno
      const h = parseInt(e.data.payload && e.data.payload.height, 10);
      const frame = box.querySelector('iframe');
      if (frame && h > 300) frame.style.height = h + 'px';
    }
    if (ev === 'calendly.date_and_time_selected') track('schedule_start', { form_location: 'contacto' });
    if (ev === 'calendly.event_scheduled') {
      track('generate_lead', { form_location: 'contacto', lead_method: 'agenda', lead_service_primary: '(reunión agendada)', lead_services: '(reunión agendada)', lead_services_count: 0 });
      track('lead_service', { lead_service: '(reunión agendada)', form_location: 'contacto' });
    }
  });
</script>
