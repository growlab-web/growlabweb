---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Manifesto from '../../components/Manifesto.astro';
import Process from '../../components/Process.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services.js';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---

<Layout title={`${service.name} · GrowLab Agencia Digital`} description={service.intro}>
  <Nav />
  <main class="page-in">
    <PageHero
      shape={service.shape}
      eyebrow={`Servicios · ${service.name}`}
      lines={service.tagline}
      text={service.intro}
    />

    <Manifesto eyebrow="Qué es" text={service.long} />

    <!-- qué incluye -->
    <section class="border-t border-white/10 px-(--pad) py-[12vh]">
      <div data-reveal class="mb-[7vh]">
        <p class="eyebrow">Qué incluye</p>
        <h2 class="max-w-[16em] text-[clamp(2rem,5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.03em]">
          Todo lo necesario en {service.name}
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {
          service.includes.map((item, i) => (
            <article data-reveal class="rounded-[28px] border border-white/10 bg-panel p-8 transition-colors duration-300 hover:border-secondary">
              <span class="font-display text-[.9rem] font-medium text-secondary">0{i + 1}</span>
              <h3 class="mb-3 mt-3 text-[1.6rem] font-medium tracking-[-0.03em]">{item.t}</h3>
              <p class="max-w-[46ch] text-muted">{item.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- resultados -->
    <section class="grid gap-8 border-t border-white/10 px-(--pad) py-[10vh] md:grid-cols-3">
      {
        service.benefits.map((b) => (
          <div data-reveal class="flex items-start gap-4 border-t border-white/15 pt-6">
            <i class="mt-[.55rem] h-2 w-2 shrink-0 rounded-full bg-secondary"></i>
            <p class="font-display text-[1.35rem] font-medium leading-snug tracking-[-0.02em]">{b}</p>
          </div>
        ))
      }
    </section>

    <Process />

    <!-- otros servicios -->
    <section class="border-t border-white/10 px-(--pad) py-[10vh]">
      <p data-reveal class="eyebrow">Otros servicios</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((s) => (
            <a data-reveal href={`/servicios/${s.slug}`} class="group flex items-center justify-between gap-4 rounded-2xl border border-white/10 px-6 py-5 transition-colors hover:border-secondary">
              <span class="font-display text-[1.15rem] tracking-[-0.02em]">{s.name}</span>
              <span class="text-white/40 transition-all group-hover:translate-x-1 group-hover:text-secondary" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <ContactSection />
  </main>
  <Footer />
</Layout>
