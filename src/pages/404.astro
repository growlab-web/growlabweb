---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada · GrowLab" description="La página que buscas no existe o cambió de dirección." noindex>
  <Nav />
  <main class="page-in">
    <section class="mx-auto flex min-h-[78vh] max-w-[820px] flex-col items-center justify-center px-(--pad) pb-[10vh] pt-[clamp(130px,20vh,210px)] text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="display-xl !text-[clamp(2.2rem,4.4vw,4.8rem)]">Esta página no existe.</h1>
      <p class="mx-auto mt-8 max-w-[46ch] font-body text-[clamp(.95rem,1.15vw,1.1rem)] leading-relaxed text-copy">
        Puede que la dirección haya cambiado o que el enlace esté mal escrito. Vuelve al inicio o cuéntanos qué buscabas.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn">Ir al inicio</a>
        <a href="/contacto" class="inline-flex items-center rounded-full border border-white/30 px-7 py-4 font-display font-medium transition-colors hover:border-white">Contacto</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
