---
// Página de error: mismos colores que el resto del sitio (fondo oscuro, blanco y verde menta), pero sin menú ni pie y con otro tono.
// El 404 gigante está hecho de partículas que huyen del cursor y vuelven a su sitio; un clic o un toque lo rompe para siempre
// (queda hecho pedazos hasta que se recarga la página).
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const metrics = [
  { v: '1', l: 'Visita', n: 'la tuya' },
  { v: '0', l: 'Clics', n: 'aquí no hay nada que pulsar' },
  { v: '0', l: 'Conversiones', n: 'ni una sola' },
  { v: '100%', l: 'Rebote', n: 'si te vas ahora', count: 100 },
];
---

<Layout title="404 · Esta página tiene un ROAS de 0x · GrowLab" description="La página que buscas no existe o cambió de dirección." noindex>
  <main data-notfound class="relative flex h-[100svh] min-h-[540px] flex-col overflow-hidden bg-[linear-gradient(175deg,#030814_0%,#000_55%,#000_100%)] text-white lining-nums">
    <!-- degradados del fondo, como en las demás páginas -->
    <div class="pointer-events-none absolute -left-[16vw] -top-[10vw] h-[30vw] w-[62vw] rotate-[-16deg] opacity-45 blur-[80px] max-sm:h-[80vw] max-sm:w-[130vw]" aria-hidden="true">
      <i class="aurora-blob aurora-blob--a bg-[radial-gradient(closest-side,#386fde,#1d3f94_55%,transparent)]"></i>
    </div>
    <div class="pointer-events-none absolute -right-[14vw] top-[45%] h-[26vw] w-[60vw] opacity-20 blur-[90px] max-sm:h-[70vw] max-sm:w-[120vw]" aria-hidden="true">
      <i class="aurora-blob aurora-blob--b bg-[radial-gradient(closest-side,#6df2c0,#1f8f68_55%,transparent)]"></i>
    </div>

    <header class="relative z-[2] flex shrink-0 items-center justify-between px-(--pad) pt-[clamp(14px,3vh,28px)]">
      <a href="/" aria-label="GrowLab, ir al inicio"><img src="/logo.png" alt="GrowLab" width="1046" height="205" class="h-[22px] w-auto" /></a>
      <span class="font-display text-[.72rem] uppercase tracking-[.22em] text-secondary">Error 404</span>
    </header>

    <!-- el 404 de partículas ocupa el alto que deja libre el resto, para que todo quepa en una pantalla sin scroll -->
    <div class="relative z-[1] min-h-[100px] w-full flex-1">
      <canvas data-notfound-canvas class="absolute inset-0 h-full w-full touch-manipulation" aria-hidden="true"></canvas>
      <p class="pointer-events-none absolute inset-x-0 bottom-0 text-center font-display text-[.66rem] uppercase tracking-[.2em] text-white/45 max-sm:text-[.56rem]">
        <span data-notfound-hint><span class="nf-fine">Pasa el cursor por el número · haz clic para romperlo</span><span class="nf-coarse">Toca el número para romperlo</span></span>
      </p>
    </div>

    <section class="relative z-[2] mx-auto w-full max-w-[1100px] shrink-0 px-(--pad) pb-[clamp(14px,3.5vh,40px)] pt-[clamp(10px,2.5vh,24px)] text-center">
      <h1 class="mx-auto max-w-[16em] font-accent text-[clamp(1.45rem,min(4.6vw,6.6vh),4.2rem)] font-bold uppercase leading-[1.02] tracking-[-0.02em]">
        <span class="sr-only">Error 404. </span>Esta página tiene un ROAS de <span class="text-secondary">0x.</span>
      </h1>
      <p class="mx-auto mt-[clamp(10px,2.2vh,24px)] max-w-[52ch] font-body text-[clamp(.9rem,1.2vw,1.1rem)] leading-relaxed text-copy max-sm:leading-snug">
        La buscamos en Analytics, en Tag Manager y hasta en la carpeta de spam. Nada: ni una impresión, ni un clic. Lo bueno es que el resto del sitio sí funciona.
      </p>

      <!-- "reporte" de la página perdida -->
      <dl class="mx-auto mt-[clamp(14px,3.2vh,40px)] grid max-w-[880px] grid-cols-4 border-y border-white/20">
        {
          metrics.map((m, i) => (
            <div class:list={['px-1 py-[clamp(10px,2vh,20px)] sm:px-3', i > 0 && 'border-l border-white/20']}>
              <dd class="font-accent text-[clamp(1.4rem,min(4vw,5.4vh),3.4rem)] font-bold leading-none tracking-[-0.03em]" data-count={m.count} data-suffix={m.count ? '%' : undefined}>{m.v}</dd>
              <dt class="mt-2 font-display text-[.78rem] font-medium uppercase tracking-[.14em] text-secondary max-sm:text-[.5rem] max-sm:tracking-[.04em]">{m.l}</dt>
              <p class="mt-1 font-body text-[.8rem] text-muted max-md:hidden">{m.n}</p>
            </div>
          ))
        }
      </dl>

      <div class="mt-[clamp(14px,3.2vh,40px)] flex flex-wrap justify-center gap-x-4 gap-y-2.5">
        <a href="/" class="inline-flex items-center gap-3 rounded-full bg-secondary px-8 py-[clamp(10px,1.8vh,16px)] font-display font-medium text-black transition-colors duration-300 hover:bg-white">Volver al inicio</a>
        <a href={site.contact.href} class="inline-flex items-center rounded-full border border-white/30 px-8 py-[clamp(10px,1.8vh,16px)] font-display font-medium transition-colors hover:border-white">Avísanos del enlace roto</a>
      </div>
    </section>

    <!-- cinta de "noticias" al pie -->
    <div class="relative z-[2] shrink-0 overflow-hidden border-t border-white/10 bg-panel py-[clamp(7px,1.3vh,12px)] text-white/80" aria-hidden="true">
      <div class="nf-ticker flex w-max whitespace-nowrap font-accent text-[.95rem] font-bold uppercase tracking-[.06em]">
        {[0, 1].map(() => <span class="pr-10">Página no encontrada ✦ CTR 0 % ✦ Presupuesto gastado: 0 ✦ Leads generados: 0 ✦ Seguimos optimizando ✦ La culpa fue del enlace ✦ </span>)}
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .nf-coarse { display: none; }
  @media (pointer: coarse) { .nf-fine { display: none; } .nf-coarse { display: inline; } }
  .nf-ticker { animation: nf-ticker 22s linear infinite; }
  @keyframes nf-ticker { to { transform: translateX(-50%); } }
</style>

<script>
  import { track } from '../scripts/track.js';

  // medición: qué direcciones rotas se están visitando y desde dónde
  track('page_not_found', { missing_path: location.pathname, referrer: document.referrer || '(directo)' });

  const canvas = document.querySelector<HTMLCanvasElement>('[data-notfound-canvas]');
  const ctx = canvas && canvas.getContext('2d');
  if (canvas && ctx) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    type Dot = { x: number; y: number; hx: number; hy: number; vx: number; vy: number; r: number };
    let w = 0, h = 0, dots: Dot[] = [], broken = false;
    const mouse = { x: -9999, y: -9999 };

    // las partículas salen de dibujar «404» en un lienzo oculto y quedarse con los puntos que caen dentro de las letras
    function build() {
      w = canvas!.clientWidth; h = canvas!.clientHeight;
      canvas!.width = w * dpr; canvas!.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (broken) return;                                            // ya roto: al cambiar el tamaño no se recompone
      const off = document.createElement('canvas'); off.width = w; off.height = h;
      const o = off.getContext('2d', { willReadFrequently: true });
      if (!o) return;
      let size = h * 0.86;                                          // deja sitio debajo para la línea de ayuda
      o.font = `800 ${size}px Syne, system-ui, sans-serif`;
      const fit = (w * 0.9) / o.measureText('404').width;
      if (fit < 1) size *= fit;                                     // en pantallas estrechas manda el ancho
      o.font = `800 ${size}px Syne, system-ui, sans-serif`;
      o.textAlign = 'center'; o.textBaseline = 'middle'; o.fillStyle = '#000';
      o.fillText('404', w / 2, h * 0.46);
      const data = o.getImageData(0, 0, w, h).data, gap = w < 600 ? 4 : 5, old = dots;
      dots = [];
      for (let y = 0; y < h; y += gap) for (let x = 0; x < w; x += gap) {
        if (data[(y * w + x) * 4 + 3] < 128) continue;
        const prev = old[dots.length];                               // al redimensionar, cada partícula viaja a su nuevo sitio
        dots.push({ hx: x, hy: y, x: prev ? prev.x : Math.random() * w, y: prev ? prev.y : -20 - Math.random() * h, vx: 0, vy: 0, r: gap * (0.3 + Math.random() * 0.22) });
      }
      if (still) { dots.forEach((d) => { d.x = d.hx; d.y = d.hy; }); draw(); }
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      // mismo degradado que los objetos 3D del sitio: verde menta arriba, azul abajo
      const grad = ctx!.createLinearGradient(0, h * 0.15, 0, h * 0.85);
      grad.addColorStop(0, '#6df2c0'); grad.addColorStop(0.55, '#7ba5f0'); grad.addColorStop(1, '#386fde');
      ctx!.fillStyle = grad;
      ctx!.beginPath();
      for (const d of dots) { ctx!.moveTo(d.x + d.r, d.y); ctx!.arc(d.x, d.y, d.r, 0, 6.283); }
      ctx!.fill();
    }

    function frame() {
      requestAnimationFrame(frame);
      for (const d of dots) {
        const dx = d.x - mouse.x, dy = d.y - mouse.y, dist = Math.hypot(dx, dy);
        if (dist < 90) { const f = ((90 - dist) / 90) * 2.4; d.vx += (dx / (dist || 1)) * f; d.vy += (dy / (dist || 1)) * f; }   // huyen del cursor
        if (!broken) { d.vx += (d.hx - d.x) * 0.02; d.vy += (d.hy - d.y) * 0.02; }                                            // y vuelven a su sitio… mientras no se rompa
        d.vx *= broken ? 0.93 : 0.88; d.vy *= broken ? 0.93 : 0.88;
        d.x += d.vx; d.y += d.vy;
        if (broken) {                                                                                                         // los pedazos rebotan en los bordes y se quedan donde caen
          if (d.x < d.r) { d.x = d.r; d.vx *= -0.6; } else if (d.x > w - d.r) { d.x = w - d.r; d.vx *= -0.6; }
          if (d.y < d.r) { d.y = d.r; d.vy *= -0.6; } else if (d.y > h - d.r) { d.y = h - d.r; d.vy *= -0.6; }
        }
      }
      draw();
    }

    // clic o toque: el número estalla desde ese punto y ya no se recompone
    const hint = document.querySelector('[data-notfound-hint]');
    function burst(cx: number, cy: number) {
      if (!broken) { broken = true; if (hint) hint.textContent = 'Listo, lo rompiste. Recarga la página si lo quieres de vuelta'; track('notfound_broken'); }
      for (const d of dots) {
        const dx = d.x - cx, dy = d.y - cy, dist = Math.hypot(dx, dy) || 1, f = Math.max(0, 1 - dist / (w * 0.7)) * (16 + Math.random() * 22);
        d.vx += (dx / dist) * f + (Math.random() - 0.5) * 3; d.vy += (dy / dist) * f + (Math.random() - 0.5) * 3;   // con algo de azar, para que no queden filas
      }
    }
    const at = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };

    (document.fonts ? document.fonts.load('800 100px Syne') : Promise.resolve()).catch(() => {}).then(() => {
      build();
      if (still) return;
      window.addEventListener('pointermove', (e) => { const p = at(e); mouse.x = p.x; mouse.y = p.y; }, { passive: true });
      window.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });
      canvas.addEventListener('pointerdown', (e) => { const p = at(e); burst(p.x, p.y); if (e.pointerType !== 'mouse') mouse.x = mouse.y = -9999; });
      requestAnimationFrame(frame);
    });
    let timer = 0;
    window.addEventListener('resize', () => { clearTimeout(timer); timer = window.setTimeout(build, 200); });
  }
</script>
