---
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import Consent from '../components/Consent.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { site } from '../data/site.js';
import { servicesFor } from '../data/services.js';
import { useLang, toEn, toEs } from '../i18n.js';

interface Props {
  title: string;
  description: string;
  app?: boolean; // página a pantalla completa (portafolio 3D): sin scroll de documento ni Lenis
  image?: string; // imagen al compartir el enlace (por defecto, la general del sitio)
  noindex?: boolean; // páginas que no deben salir en buscadores (p. ej. la de error)
  intro?: boolean; // pantalla de carga con lluvia: sólo el inicio (en las demás retrasaría el primer contenido sin aportar nada)
  type?: 'website' | 'article'; // og:type (los artículos del blog son «article»)
  jsonld?: object[]; // datos estructurados extra de la página (artículo, migas de pan…)
  published?: Date; // artículos: fechas para redes y buscadores
  modified?: Date;
  alt?: string; // dirección de esta misma página en el otro idioma (si no se da, se deduce: /nosotros ↔ /en/about)
}
const { title, description, app = false, image = '/og.jpg', noindex = false, intro = false, type = 'website', jsonld = [], published, modified, alt } = Astro.props;
const { lang, en, t } = useLang(Astro);
const services = servicesFor(lang);

// versión de esta página en el otro idioma: la usan las etiquetas hreflang (Google) y el botón ES | EN del menú (Astro.locals)
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const other = alt || (en ? toEs(here) : toEn(here));
const esPath = en ? other : here, enPath = en ? here : other;
Astro.locals.altPath = other;

// dirección oficial de la página (sin barra final) e imagen para redes, siempre con el dominio completo
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL(image, site.url).href;

// datos estructurados: le dicen a Google y a los buscadores con IA quién es GrowLab, dónde opera y qué servicios ofrece
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#organizacion`,
      name: site.name,
      description: t('Agencia de marketing digital en Arequipa, Perú, orientada a datos. Trabaja con marcas de todo el Perú y de otros países.', 'Data-driven digital marketing agency based in Arequipa, Peru, working with brands across Peru and around the world.'),
      url: site.url,
      logo: `${site.url}/logo.png`,
      image: `${site.url}/og.jpg`,
      email: site.email,
      telephone: site.phone.href.replace('tel:', ''),
      address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.city, addressCountry: 'PE' },
      areaServed: [{ '@type': 'Country', name: site.country }, { '@type': 'Place', name: 'Todo el mundo' }],
      sameAs: site.social.map((s) => s.href),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios',
        itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.short } })),
      },
    },
    { '@type': 'WebSite', '@id': `${site.url}/#sitio`, url: site.url, name: site.name, inLanguage: en ? 'en' : 'es-PE', publisher: { '@id': `${site.url}/#organizacion` } },
  ],
};
const gtm = /^GTM-[A-Z0-9]+$/.test(site.gtm) ? site.gtm : '';
---

<!doctype html>
<html lang={en ? 'en' : 'es-PE'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- verificación de propiedad en Google Search Console (no borrar: si falta, Google deja de reconocer el sitio) -->
    <meta name="google-site-verification" content="lBS8nLX6IZHio0Nv10is7NlVqvQU3PmptiiEvhDqMdg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <!-- la misma página en el otro idioma (Google muestra a cada visitante la de su idioma; x-default = español) -->
    {!noindex && <link rel="alternate" hreflang="es" href={new URL(esPath, site.url).href} />}
    {!noindex && <link rel="alternate" hreflang="en" href={new URL(enPath, site.url).href} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(esPath, site.url).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={en ? 'en_US' : 'es_PE'} />
    <meta property="og:locale:alternate" content={en ? 'es_PE' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t('Blog de GrowLab', 'GrowLab Blog')} href={en ? '/en/blog/rss.xml' : '/blog/rss.xml'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- tipografías propias: se piden cuanto antes para que el primer texto ya salga con su letra -->
    <link rel="preload" href="/fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/host-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-sans.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {
      gtm && (
        /* Google Tag Manager, con el consentimiento fijado ANTES de que cargue (Consent Mode v2): lo ya elegido por el visitante o el valor por defecto */
        <script is:inline define:vars={{ gtm, consentDefault: site.consentDefault }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          var choice = null;
          try { choice = localStorage.getItem('gl-consent'); } catch (e) {}
          var state = choice === 'all' ? 'granted' : choice === 'necessary' ? 'denied' : consentDefault === 'granted' ? 'granted' : 'denied';
          gtag('consent', 'default', { ad_storage: state, ad_user_data: state, ad_personalization: state, analytics_storage: state, wait_for_update: 500 });
          // Tag Manager (y con él GA4, Meta, TikTok…) se carga cuando el visitante interactúa por primera vez (scroll, toque, clic,
          // tecla) o a los 3,5 s de terminar la carga, lo que pase antes. Sus ~900 KB ya no compiten con el contenido al abrir la
          // página. Los eventos que el sitio deja antes en dataLayer no se pierden: GTM los procesa al llegar.
          var gtmLoaded = false;
          var loadGtm = function () {
            if (gtmLoaded) return; gtmLoaded = true;
            ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) { removeEventListener(e, loadGtm, true); });
            (function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); var f = d.getElementsByTagName(s)[0], j = d.createElement(s); j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer', gtm);
          };
          ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) { addEventListener(e, loadGtm, { capture: true, passive: true, once: true }); });
          addEventListener('load', function () { setTimeout(loadGtm, 3500); });
        </script>
      )
    }
    <!-- evita el parpadeo de la pantalla de carga si ya se vio en esta sesión -->
    <script is:inline>
      try { if (sessionStorage.getItem('gl-intro') === '1') document.documentElement.classList.add('intro-seen'); } catch (e) {}
      // llegada con ancla (p. ej. /#servicios): el navegador no salta por su cuenta, porque las posiciones aún no son las finales;
      // la página queda oculta un instante y main.js la muestra ya colocada en la sección (ver scrollToHash)
      try {
        if (location.hash.length > 1) {
          window.__glHash = location.hash;
          window.__glHashArrived = true;       // se llegó con ancla (la dirección queda sin ella, ver main.js)
          history.replaceState(null, '', location.pathname + location.search);
          document.documentElement.classList.add('hash-pending');
          setTimeout(function () { document.documentElement.classList.remove('hash-pending'); }, 4500);   // por si el script principal no llega a ejecutarse
        }
      } catch (e) {}
    </script>
  </head>
  <body class:list={['bg-black font-body text-white antialiased', app ? 'h-screen overflow-hidden' : 'overflow-x-hidden']} data-app={app ? '' : undefined}>
    {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    {intro && <Loader />}
    <a href="#contenido" class="skip-link" id="saltar-al-contenido">{t('Saltar al contenido', 'Skip to content')}</a>
    <slot />
    <WhatsApp />
    {gtm && <Consent />}
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
