---
// Cifras con contador animado (GSAP): data-count / data-dec / data-suffix.
const stats = [
  { v: 250, s: '+', l: 'Proyectos entregados' },
  { v: 4.8, s: 'x', d: 1, l: 'ROAS medio en campañas' },
  { v: 12, s: 'M€', l: 'Facturación generada' },
  { v: 98, s: '%', l: 'Clientes que repiten' },
];
---

<section data-stats class="grid gap-10 border-t border-white/10 px-(--pad) py-[12vh] sm:grid-cols-2 lg:grid-cols-4">
  {
    stats.map((s) => (
      <div data-reveal>
        <b
          data-count={s.v}
          data-dec={s.d ?? 0}
          data-suffix={s.s}
          class="block bg-gradient-to-b from-white to-white/40 bg-clip-text font-display text-[clamp(3.2rem,7vw,6.5rem)] font-medium leading-none tracking-[-0.05em] text-transparent"
        >
          0
        </b>
        <span class="mt-2 block text-muted">{s.l}</span>
      </div>
    ))
  }
</section>
