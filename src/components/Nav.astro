---
const links = [
  { href: '#top', label: 'Inicio' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#casos', label: 'Casos' },
  { href: '#proceso', label: 'Proceso' },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-[17px] z-[70] mx-auto flex h-[42px] w-[min(650px,calc(100%-24px))] items-center justify-between gap-4 border border-white/10 bg-[#08080bd9] px-[22px] backdrop-blur-md"
>
  <a href="#top" aria-label="GrowLab, ir al inicio" class="flex items-center">
    <img src="/logo.png" alt="GrowLab" width="815" height="170" class="h-[27px] w-auto" />
  </a>

  <nav class="hidden gap-7 font-display text-[.92rem] font-light sm:flex" aria-label="Principal">
    {
      links.map((l) => (
        <a href={l.href} class="opacity-90 transition hover:text-secondary hover:opacity-100">
          {l.label}
        </a>
      ))
    }
  </nav>

  <a
    href="#contacto"
    class="inline-flex h-[30px] items-center gap-[.7rem] border border-white/85 px-3 font-display text-[.92rem] font-light transition-colors hover:bg-white hover:text-black"
  >
    Contacto <i class="h-[3px] w-[3px] rounded-full bg-current"></i>
  </a>
</header>
