---
// Las palabras se separan en JS (scripts/main.js) y se iluminan con el scroll.
import { useLang } from '../i18n.js';
const { t } = useLang(Astro);
interface Props { eyebrow?: string; text?: string }
const {
  eyebrow = t('Quiénes somos', 'Who we are'),
  text = t('No vendemos likes ni métricas vanidosas. Combinamos creatividad y datos para construir marcas memorables y campañas que generan ingresos reales. Cada decisión se mide, cada idea se prueba y cada sol invertido trabaja para tu crecimiento.', 'We don’t sell likes or vanity metrics. We combine creativity and data to build memorable brands and campaigns that drive real revenue. Every decision is measured, every idea is tested and every dollar invested works for your growth.'),
} = Astro.props;
---

<!-- sin parada de scroll: es una lectura breve y frenar aquí se sentía como que la página se estancaba -->
<section class="mx-auto max-w-[1100px] px-(--pad) py-[11vh] max-sm:py-[7vh]">
  <p class="eyebrow">{eyebrow}</p>
  <p
    data-manifesto
    class="text-left font-display text-[clamp(1.2rem,2vw,1.85rem)] font-medium leading-[1.4] tracking-[-0.01em]"
  >
    {text}
  </p>
</section>

<style>
  [data-manifesto] :global(.w) {
    display: inline-block;
    opacity: 0.14;
  }
</style>
