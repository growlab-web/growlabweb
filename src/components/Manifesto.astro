---
// Las palabras se separan en JS (scripts/main.js) y se iluminan con el scroll.
interface Props { eyebrow?: string; text?: string }
const {
  eyebrow = 'Quiénes somos',
  text = 'No vendemos likes ni métricas vanidosas. Combinamos creatividad y datos para construir marcas memorables y campañas que generan ingresos reales. Cada decisión se mide, cada idea se prueba y cada euro invertido trabaja para tu crecimiento.',
} = Astro.props;
---

<section data-stop="center" class="mx-auto max-w-[1100px] px-(--pad) py-[11vh]">
  <p class="eyebrow">{eyebrow}</p>
  <p
    data-manifesto
    class="text-left font-display text-[clamp(1.2rem,2vw,1.85rem)] font-medium leading-[1.4] tracking-[-0.01em]"
  >
    {text}
  </p>
</section>

<style>
  [data-manifesto] :global(.w) {
    display: inline-block;
    opacity: 0.14;
  }
</style>
