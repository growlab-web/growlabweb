---
const a = 'Paid Media ✦ SEO ✦ Web Development & Ecommerce ✦ UX/UI Design ✦ AI Automation ✦ Data Analytics ✦ Tracking & Attribution ✦ Reporting ✦ ';
const b = 'Estrategia ✦ Creatividad ✦ Datos ✦ Crecimiento ✦ ';
---

<section data-marquee class="overflow-hidden border-y border-white/10 bg-panel py-[3vw]">
  <div
    data-marquee-row="-1"
    class="w-max whitespace-nowrap font-accent text-[clamp(1.2rem,2.5vw,2.2rem)] font-bold uppercase leading-[1.15] tracking-[-0.01em]"
  >
    <span>{a.repeat(2)}</span>
  </div>
  <div
    data-marquee-row="1"
    class="w-max whitespace-nowrap font-display text-[clamp(1.5rem,3.6vw,3.2rem)] font-bold leading-[1.1] tracking-[-0.04em] text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,.35)]"
  >
    <span>{b.repeat(3)}</span>
  </div>
</section>
