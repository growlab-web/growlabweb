---
import { site } from '../data/site.js';
import { services } from '../data/services.js';

// Prefijos telefónicos del desplegable: Perú primero (es el que sale elegido) y el resto por orden alfabético
const countries = [
  ['Perú', '+51'], ['Alemania', '+49'], ['Argentina', '+54'], ['Bolivia', '+591'], ['Brasil', '+55'], ['Canadá', '+1'], ['Chile', '+56'],
  ['Colombia', '+57'], ['Costa Rica', '+506'], ['Ecuador', '+593'], ['El Salvador', '+503'], ['España', '+34'], ['Estados Unidos', '+1'],
  ['Francia', '+33'], ['Guatemala', '+502'], ['Honduras', '+504'], ['Italia', '+39'], ['México', '+52'], ['Nicaragua', '+505'], ['Panamá', '+507'],
  ['Paraguay', '+595'], ['Portugal', '+351'], ['Puerto Rico', '+1'], ['Reino Unido', '+44'], ['República Dominicana', '+1'], ['Uruguay', '+598'], ['Venezuela', '+58'],
];

// Campos con línea inferior e icono, como un formulario editorial
const wrap = 'group relative flex items-center gap-3 border-b border-white/20 transition-colors focus-within:border-secondary';
const icon = 'h-[22px] w-[22px] shrink-0 text-white/45 transition-colors group-focus-within:text-secondary';
const input = 'w-full bg-transparent py-4 font-body text-[1rem] text-white outline-none placeholder:text-white/40';
---

<!-- El formulario se envía a /api/contacto.php (hosting cPanel), que guarda el lead y lo manda al correo de GrowLab.
     Nunca abre el programa de correo del visitante. En local (npm run dev) y en la vista previa de Vercel no hay PHP: ahí el envío se simula para poder
     ver la pantalla de gracias, y se avisa de que no se ha mandado ningún correo. -->
<form data-contact-form data-email={site.email} class="grid gap-x-10 gap-y-7 sm:grid-cols-2" novalidate>
  <label class={wrap}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path></svg>
    <span class="sr-only">Nombre</span>
    <input class={input} name="nombre" type="text" placeholder="Nombre *" autocomplete="name" required aria-required="true" />
  </label>

  <label class={wrap}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m3.5 6.5 8.5 7 8.5-7"></path></svg>
    <span class="sr-only">Email</span>
    <input class={input} name="email" type="email" placeholder="Email *" autocomplete="email" required aria-required="true" />
  </label>

  <!-- Teléfono: prefijo del país (desplegable del sistema, con Perú por defecto) + número -->
  <div class={wrap}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
    <span class="relative flex shrink-0 items-center gap-1.5 py-4 font-body text-[1rem] text-white">
      <span data-prefix-label>+51</span>
      <svg class="h-3.5 w-3.5 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
      <!-- el desplegable real va encima, invisible: se ve sólo el prefijo y al tocarlo se abre la lista del sistema -->
      <select name="prefijo" data-prefix aria-label="País del teléfono" autocomplete="tel-country-code" class="absolute inset-0 h-full w-full cursor-pointer bg-[#0b1226] text-white opacity-0">
        {countries.map(([name, code], i) => <option value={code} selected={i === 0}>{name} ({code})</option>)}
      </select>
    </span>
    <i class="h-5 w-px shrink-0 bg-white/20" aria-hidden="true"></i>
    <label class="flex-1">
      <span class="sr-only">Teléfono</span>
      <input class={input} name="telefono" type="tel" inputmode="tel" placeholder="Teléfono *" autocomplete="tel-national" required aria-required="true" />
    </label>
  </div>

  <!-- Servicios de interés: desplegable en el que se pueden marcar varios -->
  <div data-services-select class={wrap + ' z-20'}>
    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"></path></svg>
    <button type="button" data-ss-toggle aria-haspopup="true" aria-expanded="false" class="flex w-full cursor-pointer items-center justify-between gap-3 bg-transparent py-4 text-left font-body text-[1rem] outline-none">
      <span data-ss-label class="truncate text-white/40">Servicios de interés (opcional)</span>
      <svg data-ss-chevron class="h-4 w-4 shrink-0 text-white/45 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </button>
    <div data-ss-panel data-lenis-prevent hidden role="group" aria-label="Servicios de interés" class="absolute inset-x-0 top-full z-20 mt-2 max-h-[300px] overflow-y-auto overscroll-contain rounded-2xl border border-white/15 bg-[#0b1226] p-2 shadow-[0_24px_60px_rgba(0,0,0,.6)]">
      {
        services.map((s) => (
          <label class="flex cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 font-body text-[.95rem] text-white/85 transition-colors hover:bg-white/[.06]">
            <input type="checkbox" name="servicios" value={s.name} class="h-[18px] w-[18px] shrink-0 cursor-pointer accent-secondary" />
            <span>{s.name}</span>
          </label>
        ))
      }
    </div>
  </div>

  <label class={wrap + ' items-start sm:col-span-2'}>
    <svg class={icon + ' mt-4'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 0l0 0a2 2 0 0 1 0 3L8 19l-4 1Z"></path><path d="m14 7 3 3"></path></svg>
    <span class="sr-only">Mensaje</span>
    <textarea class={input + ' min-h-[110px] resize-none'} name="mensaje" placeholder="¿Cómo podemos ayudar? ¡No dudes en ponerte en contacto con nosotros!"></textarea>
  </label>

  <!-- campo trampa para robots: las personas no lo ven ni llegan a él con el teclado -->
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>No rellenes este campo <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-3 sm:col-span-2">
    <button type="submit" data-form-submit class="inline-flex h-[54px] cursor-pointer disabled:cursor-wait disabled:opacity-60 items-center gap-3 bg-secondary px-8 font-display text-[.85rem] font-semibold uppercase tracking-[.12em] text-black transition-colors hover:bg-white">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 3-9.5 18-2.5-7.5L1.5 11 21 3Z"></path><path d="M21 3 9 13.5"></path></svg>
      Enviar
    </button>
    <label class="flex cursor-pointer items-center gap-3 font-body text-[.9rem] text-white/60">
      <input type="checkbox" name="consent" class="h-[18px] w-[18px] shrink-0 cursor-pointer accent-secondary" />
      <span>Acepto que se recopilen mis <a href={site.privacy.href} target="_blank" class="underline underline-offset-2 transition-colors hover:text-secondary">datos</a>.</span>
    </label>
  </div>

  <p data-form-note class="min-h-[1.4em] font-body text-[.85rem] text-muted sm:col-span-2" role="status" aria-live="polite"></p>
</form>

<!-- Pantalla de gracias: sustituye al formulario cuando el envío sale bien, con un mini juego para la espera (scripts/pong.js) -->
<div data-form-thanks hidden class="text-center" role="status" aria-live="polite">
  <p data-form-test hidden class="mx-auto mb-5 w-fit rounded-full border border-[#ffcf7a]/50 px-4 py-1.5 font-ui text-[.78rem] text-[#ffcf7a]">Modo de prueba: aquí no se envía ningún correo</p>
  <p class="eyebrow">¡Gracias por tus datos!</p>
  <h3 class="mx-auto max-w-[18em] font-display text-[clamp(1.5rem,2.8vw,2.4rem)] font-medium leading-[1.08] tracking-[-0.03em]">Mientras esperas nuestra respuesta, juega un poco.</h3>
  <p class="mx-auto mt-4 max-w-[46ch] font-body leading-relaxed text-copy">
    Recibimos tu mensaje y te responderemos en menos de 24 horas laborables.
  </p>

  <div class="mx-auto mt-7 max-w-[720px]">
    <canvas data-pong class="block h-[clamp(220px,38vh,340px)] w-full cursor-none touch-none rounded-[22px] border border-white/15 bg-white/[.03]" aria-label="Juego: para la pelota con las barras moviendo el ratón arriba y abajo"></canvas>
    <p class="mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 font-ui text-[.8rem] uppercase tracking-[.14em] text-white/55">
      <span>Rebotes: <b data-pong-score class="font-medium text-secondary">0</b></span>
      <span>Tu récord: <b data-pong-best class="font-medium text-white">0</b></span>
    </p>
  </div>

  <button type="button" data-form-again class="mt-6 cursor-pointer font-body text-[.9rem] text-white/60 underline underline-offset-4 transition-colors hover:text-secondary">Enviar otro mensaje</button>
</div>

<script>
  import { track } from '../scripts/track.js';
  import { initPong } from '../scripts/pong.js';

  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    const note = form.querySelector('[data-form-note]');
    const button = form.querySelector('[data-form-submit]');
    const where = form.closest('[data-contact]') ? 'inicio' : 'contacto';

    // pantalla de gracias con el juego: aparece en lugar del formulario y «Enviar otro mensaje» lo devuelve
    const thanks = form.nextElementSibling && form.nextElementSibling.matches('[data-form-thanks]') ? form.nextElementSibling : null;
    let game = null;
    const showThanks = () => {
      if (!thanks) return false;
      form.hidden = true; thanks.hidden = false;
      const scoreEl = thanks.querySelector('[data-pong-score]'), bestEl = thanks.querySelector('[data-pong-best]');
      let played = false;
      game = initPong(thanks.querySelector('[data-pong]'), {
        onScore: (score, best) => { scoreEl.textContent = String(score); bestEl.textContent = String(best); },
        onState: (state) => { if (state === 'juego' && !played) { played = true; track('thanks_game_play', { form_location: where }); } },
      });
      thanks.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return true;
    };
    if (thanks) thanks.querySelector('[data-form-again]').addEventListener('click', () => {
      if (game) { game.stop(); game = null; }
      thanks.hidden = true; form.hidden = false; say('');
    });

    // desplegable de servicios: se abre y cierra con el botón, y se cierra al pulsar fuera o con Escape
    const ss = form.querySelector('[data-services-select]');
    let resetServices = () => {};
    if (ss) {
      const toggle = ss.querySelector('[data-ss-toggle]'), panel = ss.querySelector('[data-ss-panel]');
      const label = ss.querySelector('[data-ss-label]'), chevron = ss.querySelector('[data-ss-chevron]');
      const empty = label.textContent;
      const open = (on) => { panel.hidden = !on; toggle.setAttribute('aria-expanded', String(on)); chevron.style.transform = on ? 'rotate(180deg)' : ''; };
      const paint = () => {
        const picked = [...panel.querySelectorAll('input:checked')].map((i) => i.value);
        label.textContent = picked.length ? picked.join(', ') : empty;
        label.classList.toggle('text-white/40', !picked.length);
        label.classList.toggle('text-white', picked.length > 0);
      };
      toggle.addEventListener('click', () => open(panel.hidden));
      document.addEventListener('pointerdown', (e) => { if (!panel.hidden && !ss.contains(e.target)) open(false); });
      ss.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { open(false); toggle.focus(); } });
      panel.addEventListener('change', paint);
      resetServices = () => { open(false); paint(); };
    }

    // prefijo del teléfono: el texto visible sigue al país elegido en el desplegable
    const prefix = form.querySelector('[data-prefix]'), prefixLabel = form.querySelector('[data-prefix-label]');
    const paintPrefix = () => { if (prefix && prefixLabel) prefixLabel.textContent = prefix.value; };
    if (prefix) prefix.addEventListener('change', paintPrefix);
    paintPrefix();

    // medición: primer campo que toca el visitante
    form.addEventListener('focusin', () => track('form_start', { form_location: where }), { once: true });

    const say = (msg, kind) => { note.textContent = msg; note.style.color = kind === 'error' ? '#ff9a9a' : kind === 'ok' ? '#6df2c0' : ''; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const nombre = String(f.get('nombre') || '').trim();
      const email = String(f.get('email') || '').trim();
      const telefono = String(f.get('telefono') || '').trim();
      const mensaje = String(f.get('mensaje') || '').trim();
      const servicios = f.getAll('servicios').map(String);
      // obligatorios: nombre, correo y teléfono (el teléfono, con al menos 6 dígitos); servicios y mensaje son opcionales
      const missing = [!nombre && 'tu nombre', !/^\S+@\S+\.\S+$/.test(email) && 'un correo válido', telefono.replace(/\D/g, '').length < 6 && 'un teléfono válido'].filter(Boolean);
      if (missing.length) {
        const field = form.querySelector(!nombre ? '[name=nombre]' : missing[0] === 'un correo válido' ? '[name=email]' : '[name=telefono]');
        if (field) field.focus();
        return say(`Completa ${missing.join(missing.length > 2 ? ', ' : ' y ').replace(/, ([^,]*)$/, ' y $1')}.`, 'error');
      }
      if (!f.get('consent')) return say('Para enviar el mensaje debes aceptar que se recopilen tus datos.', 'error');

      // el teléfono viaja completo, con el prefijo del país delante (salvo que la persona ya lo haya escrito con +)
      const phone = telefono.startsWith('+') ? telefono : `${f.get('prefijo') || ''} ${telefono}`.trim();
      f.set('telefono', phone);
      f.delete('prefijo');
      f.set('pagina', location.href);
      button.disabled = true;
      say('Enviando…');

      let result = null;          // respuesta del servidor; null = el servicio no está disponible
      try {
        const res = await fetch('/api/contacto.php', { method: 'POST', body: f, headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (data && typeof data.ok === 'boolean') result = data;
      } catch (err) { /* sin servidor o respuesta que no es JSON: se usa el correo del visitante */ }
      button.disabled = false;

      if (result && result.ok) {
        if (!showThanks()) say('¡Gracias por tus datos! Recibimos tu mensaje y te responderemos en menos de 24 horas laborables.', 'ok');
        track('generate_lead', {
          form_location: where,
          lead_services: servicios.join(', ') || '(sin especificar)',
          lead_services_count: servicios.length,
          // sólo para conversiones mejoradas (Google Ads / Meta); no se envía a GA4, ver scripts/track.js
          user_data: { email: email.toLowerCase(), phone_number: '+' + phone.replace(/\D/g, '') },     // teléfono en formato internacional
        });
        form.reset();
        resetServices();
        paintPrefix();
        return;
      }
      if (result) return say(result.error || 'No pudimos enviar tu mensaje. Inténtalo de nuevo.', 'error');

      // el servicio no respondió
      if (['localhost', '127.0.0.1'].includes(location.hostname) || location.hostname.endsWith('.vercel.app')) {
        // en local y en la vista previa de Vercel no hay PHP: se enseña la pantalla de gracias como prueba, sin enviar nada ni contar el lead
        if (showThanks()) { const p = thanks.querySelector('[data-form-test]'); if (p) p.hidden = false; }
        form.reset(); resetServices(); paintPrefix();
        return say('Modo de prueba: aquí no se envía el correo. El envío real funciona con el sitio subido al hosting de growlab.pe.');
      }
      say(`No pudimos enviar tu mensaje. Inténtalo de nuevo en unos minutos o escríbenos a ${form.dataset.email}.`, 'error');
    });
  });
</script>
