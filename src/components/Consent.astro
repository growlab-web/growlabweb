---
// Aviso de cookies: sólo se muestra si hay Tag Manager (site.gtm) y el visitante aún no ha elegido.
// La elección se guarda en el navegador y se comunica a Google (Consent Mode v2); el estado inicial lo fija Layout.astro.
import { site } from '../data/site.js';
import { useLang } from '../i18n.js';
const { t, href } = useLang(Astro);
---

<div
  data-consent
  hidden
  role="dialog"
  aria-label={t('Aviso de cookies', 'Cookie notice')}
  class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-[560px] rounded-[22px] border border-white/15 bg-[#0b1120]/[.97] p-5 font-ui text-[.9rem] text-copy shadow-[0_24px_60px_rgba(0,0,0,.6)] sm:inset-x-auto sm:left-5 sm:bottom-5 sm:mx-0"
>
  <p class="leading-relaxed">
    <!-- el texto del enlace dice a dónde lleva («Más información» a secas no lo dice: Google y los lectores de pantalla lo marcan) -->
    {t('Usamos cookies para medir las visitas y mejorar el sitio. Puedes aceptarlas o seguir solo con las necesarias. Consulta nuestra', 'We use cookies to measure visits and improve the site. You can accept them or continue with only the essential ones. Read our')} <a href={href(site.privacy.href)} id="cookies-mas-info" class="text-white underline underline-offset-2 transition-colors hover:text-secondary">{t('política de privacidad y cookies', 'privacy and cookie policy')}</a>.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button type="button" id="cookies-aceptar" data-consent-set="all" class="gtm-boton cursor-pointer rounded-full bg-secondary px-5 py-2.5 font-display text-[.85rem] font-medium text-black transition-colors hover:bg-white">{t('Aceptar', 'Accept')}</button>
    <button type="button" id="cookies-solo-necesarias" data-consent-set="necessary" class="gtm-boton cursor-pointer rounded-full border border-white/30 px-5 py-2.5 font-display text-[.85rem] text-white transition-colors hover:border-white">{t('Solo necesarias', 'Essential only')}</button>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-consent]');
  if (box) {
    const KEY = 'gl-consent';
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    const gtag = function () { w.dataLayer.push(arguments); } as (...args: unknown[]) => void;
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch (e) { /* sin almacenamiento */ }
    if (!saved) box.hidden = false;

    box.querySelectorAll<HTMLElement>('[data-consent-set]').forEach((btn) => btn.addEventListener('click', () => {
      const all = btn.dataset.consentSet === 'all', v = all ? 'granted' : 'denied';
      try { localStorage.setItem(KEY, all ? 'all' : 'necessary'); } catch (e) { /* sin almacenamiento */ }
      gtag('consent', 'update', { ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
      w.dataLayer.push({ event: 'consent_update', consent_choice: all ? 'all' : 'necessary' });
      box.hidden = true;
    }));
    // enlace «Preferencias de cookies» del pie: vuelve a mostrar el aviso
    document.querySelectorAll('[data-consent-open]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); box.hidden = false; }));
  }
</script>
