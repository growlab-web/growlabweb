---
const cases = [
  { tag: 'E-commerce · Moda', name: 'Aurora Studio', text: 'Reestructuramos su embudo de Meta Ads y email.', kpi: '+312%', kpiText: 'ventas online en 6 meses', bg: 'from-[#0e1a3a]', visual: 'v1' },
  { tag: 'SaaS · B2B', name: 'Flowly', text: 'Estrategia SEO + LinkedIn para captar demos cualificadas.', kpi: '-48%', kpiText: 'coste por lead', bg: 'from-[#15210b]', visual: 'v2' },
  { tag: 'Restauración', name: 'Casa Brasa', text: 'Contenido en vídeo corto y campañas locales.', kpi: '3,1M', kpiText: 'visualizaciones orgánicas', bg: 'from-[#0b1a44]', visual: 'v3' },
];
---

<!-- Tarjetas apiladas: sticky + escala/desenfoque con GSAP -->
<section class="px-(--pad) pb-[14vh] pt-[10vh]">
  <div data-cases-head class="mb-[8vh]">
    <p class="eyebrow">Casos de éxito</p>
    <h2 class="text-[clamp(2rem,5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.03em]">Marcas que ya crecen con GrowLab</h2>
  </div>

  <div class="flex flex-col gap-[8vh]">
    {
      cases.map((c) => (
        <article data-case class="sticky top-[12vh] will-change-transform max-md:top-[9vh]">
          <div
            data-case-inner
            class={`grid min-h-[62vh] grid-cols-[1fr_1.2fr] gap-8 overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br ${c.bg} to-panel p-[clamp(1.5rem,3vw,3rem)] max-md:grid-cols-1`}
          >
            <div class="flex flex-col justify-between gap-6">
              <span class="self-start rounded-full border border-white/20 px-3.5 py-1.5 text-[.8rem] text-muted">{c.tag}</span>
              <div class="flex flex-col gap-6">
                <h3 class="text-[clamp(2.4rem,5vw,4.5rem)] font-medium leading-none tracking-[-0.04em]">{c.name}</h3>
                <p class="max-w-[34ch] text-muted">{c.text}</p>
              </div>
              <div class="text-[1.1rem] text-muted">
                <b class="block font-accent text-[clamp(1.9rem,3.4vw,3.2rem)] font-bold leading-none tracking-[-0.03em] text-secondary">{c.kpi}</b>
                {c.kpiText}
              </div>
            </div>
            <div class={`relative min-h-[260px] overflow-hidden rounded-[20px] ${c.visual}`} />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .v1 {
    background:
      radial-gradient(circle at 30% 30%, var(--color-primary), transparent 55%),
      radial-gradient(circle at 75% 70%, var(--color-sky), transparent 55%), #0a1228;
  }
  .v2 {
    background:
      radial-gradient(circle at 70% 30%, var(--color-secondary), transparent 50%),
      radial-gradient(circle at 25% 75%, #5f8f2a, transparent 55%), #0d1706;
  }
  .v3 {
    background:
      radial-gradient(circle at 50% 40%, var(--color-sky), transparent 55%),
      radial-gradient(circle at 20% 80%, var(--color-secondary), transparent 50%), #0a1633;
  }
</style>
