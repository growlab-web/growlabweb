---
import { services } from '../data/services.js';
import Icon from './Icon.astro';
---

<!-- Scroll horizontal con pin (GSAP ScrollTrigger) -->
<section id="servicios" data-services class="relative">
  <div class="flex h-screen flex-col justify-center gap-12 overflow-hidden" data-services-pin>
    <div data-services-head class="px-(--pad)">
      <p class="eyebrow">Qué hacemos</p>
      <h2 class="max-w-[900px] text-[clamp(1.7rem,3.6vw,3.3rem)] font-medium leading-[1.02] tracking-[-0.03em]">
        Ocho frentes, un mismo objetivo: tu crecimiento
      </h2>
    </div>

    <div data-services-track class="flex w-max gap-8 px-(--pad) will-change-transform">
      {
        services.map((s) => (
          <article class="card group relative flex h-[clamp(340px,48vh,460px)] w-[clamp(280px,32vw,440px)] flex-col gap-4 overflow-hidden rounded-[28px] border border-white/10 bg-panel p-8 transition-colors duration-300 hover:border-secondary">
            <span class="font-display text-[.9rem] font-medium text-secondary">{s.n}</span>
            <h3 class="font-accent text-[1.3rem] font-bold leading-[1.15] tracking-[-0.01em]">{s.name}</h3>
            <p class="max-w-[30ch] text-muted">{s.short}</p>
            <span class="absolute right-6 top-6 grid h-12 w-12 place-items-center rounded-2xl border border-white/15 bg-white/[.04] text-secondary transition-colors duration-300 group-hover:border-secondary group-hover:bg-secondary group-hover:text-black"><Icon name={s.icon} size={22} /></span>
            <div class={`art art-${s.art}`} aria-hidden="true">
              <i />
              <i />
              <i />
              <i />
              <i />
            </div>
          </article>
        ))
      }
    </div>

    <!-- solo en móvil/tablet: aviso de que se desliza de lado + barra de avance -->
    <div class="services-hint px-(--pad)" aria-hidden="true">
      <span class="h-[2px] flex-1 overflow-hidden rounded-full bg-white/12"><i data-services-bar class="block h-full origin-left bg-secondary" style="transform:scaleX(.08)"></i></span>
      <span class="flex items-center gap-2 font-ui text-[.8rem] text-white/60">Desliza <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </div>
  </div>
</section>

<style>
  .art {
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 10px;
    padding: 0 2rem 2rem;
  }
  /* barras */
  .art-bars i,
  .art-bars-rev i {
    width: 22px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(var(--color-secondary), transparent);
  }
  .art-bars i:nth-child(1) { height: 30%; }
  .art-bars i:nth-child(2) { height: 50%; }
  .art-bars i:nth-child(3) { height: 42%; }
  .art-bars i:nth-child(4) { height: 75%; }
  .art-bars i:nth-child(5) { height: 100%; }
  .art-bars-rev i { background: linear-gradient(var(--color-sky), transparent); }
  .art-bars-rev i:nth-child(1) { height: 100%; }
  .art-bars-rev i:nth-child(2) { height: 75%; }
  .art-bars-rev i:nth-child(3) { height: 60%; }
  .art-bars-rev i:nth-child(4) { height: 45%; }
  .art-bars-rev i:nth-child(5) { height: 30%; }
  /* anillos */
  .art-rings { padding: 0; }
  .art-rings i {
    position: absolute;
    right: -40px;
    bottom: -60px;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }
  .art-rings i:nth-child(1) { width: 120px; height: 120px; }
  .art-rings i:nth-child(2) { width: 200px; height: 200px; opacity: 0.6; }
  .art-rings i:nth-child(3) { width: 290px; height: 290px; opacity: 0.3; }
  .art-rings i:nth-child(n + 4) { display: none; }
  /* formas */
  .art-shapes i { width: 70px; height: 70px; background: var(--color-sky); }
  .art-shapes i:nth-child(1) { border-radius: 50%; }
  .art-shapes i:nth-child(2) { background: var(--color-secondary); }
  .art-shapes i:nth-child(3) { background: var(--color-primary); border-radius: 50% 0 50% 0; }
  .art-shapes i:nth-child(n + 4) { display: none; }
  /* puntos */
  .art-dots i { width: 46px; height: 46px; border-radius: 50%; background: var(--color-secondary); }
  .art-dots i:nth-child(2) { background: var(--color-primary); }
  .art-dots i:nth-child(3) { background: var(--color-sky); }
  .art-dots i:nth-child(4) { background: #fff; }
  .art-dots i:nth-child(5) { display: none; }
  /* chips (automatizaciones) */
  .art-chips i {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    border: 2px solid var(--color-secondary);
  }
  .art-chips i:nth-child(1) { transform: translateY(-4px); }
  .art-chips i:nth-child(2) { transform: translateY(-22px); border-color: var(--color-primary); }
  .art-chips i:nth-child(3) { transform: translateY(-40px); background: var(--color-secondary); }
  .art-chips i:nth-child(4) { transform: translateY(-22px); border-color: var(--color-sky); }
  .art-chips i:nth-child(5) { transform: translateY(-4px); background: var(--color-primary); border-color: var(--color-primary); }
  /* sobre (email) con aviso de mensaje nuevo */
  .art-mail i:nth-child(1) {
    position: relative;
    width: 150px;
    height: 100px;
    overflow: hidden;
    border: 2px solid var(--color-sky);
    border-radius: 14px;
  }
  .art-mail i:nth-child(1)::before {
    content: '';
    position: absolute;
    left: 21.5px;
    top: -51.5px;
    width: 103px;
    height: 103px;
    border: 2px solid var(--color-sky);
    border-radius: 0 0 10px 0;
    transform: scaleY(0.62) rotate(45deg);
  }
  .art-mail i:nth-child(2) {
    position: absolute;
    right: calc(2rem - 9px);
    bottom: calc(2rem + 91px);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-secondary);
  }
  .art-mail i:nth-child(n + 3) { display: none; }
</style>
