---
import { services } from '../data/services.js';
import Partners from './Partners.astro';
import Universe from './Universe.astro';
import AiTools from './AiTools.astro';
const words = JSON.stringify(services.map((s) => s.name));
const stats = [
  { n: '250+', l: 'Proyectos entregados' },
  { n: '4,8x', l: 'ROAS medio en campañas' },
  { n: '12M€', l: 'Facturación generada' },
  { n: '98%', l: 'Clientes que repiten' },
];
---

<!--
  Hero fijo (pin) con tres etapas controladas por el scroll:
  casi-esfera  →  galaxia (panel 2)  →  cerebro (panel 3)
-->
<section
  id="top"
  data-hero
  data-pin
  class="relative h-screen min-h-[640px] max-md:min-h-[500px] overflow-hidden bg-[linear-gradient(175deg,#030814_0%,#000_45%,#000_100%)] [--gx:1.8vw]"
>
  <!-- degradados del fondo (se animan solos y con cada etapa) -->
  <div
    data-aurora="a"
    class="pointer-events-none absolute -left-[16vw] -top-[10vw] z-0 h-[26vw] w-[62vw] rotate-[-16deg] opacity-40 blur-[80px] will-change-transform"
  >
    <i class="aurora-blob aurora-blob--a bg-[radial-gradient(closest-side,#386fde,#1d3f94_55%,transparent)]"></i>
  </div>
  <div
    data-aurora="b"
    class="pointer-events-none absolute -bottom-[8vw] -right-[14vw] z-0 h-[20vw] w-[78vw] opacity-[.28] blur-[80px] will-change-transform"
  >
    <i class="aurora-blob aurora-blob--b bg-[radial-gradient(closest-side,#5b8fe6,#26509f_55%,transparent)]"></i>
  </div>
  <!-- objeto 3D -->
  <canvas id="hero3d" class="absolute inset-0 z-[1] block h-full w-full" aria-hidden="true"></canvas>

  <!-- etapa 1: titular -->
  <div data-hero-title class="pointer-events-none relative z-[2] px-(--gx) pt-24">
    <h1 class="max-w-[min(42vw,46rem)] font-accent text-[clamp(2rem,3.7vw,4.7rem)] font-bold uppercase leading-[1.04] tracking-[-0.02em] max-lg:max-w-none">
      <span data-line class="block">Crecimiento</span>
      <span data-line class="block">digital, medible</span>
      <span data-line class="block">y <span class="text-secondary">escalable.</span></span>
    </h1>
    <!-- servicios que se escriben y se borran uno tras otro -->
    <p data-foot class="mt-7 font-display font-light">
      <span class="mb-1 block font-body text-[.78rem] uppercase tracking-[.2em] text-white/50">Especialistas en</span>
      <span class="inline-flex items-center font-ui text-[clamp(1.35rem,2.1vw,2rem)] font-normal tracking-[-0.01em] text-white">
        <span data-typewriter data-words={words} aria-hidden="true">Performance &amp; Ads</span>
        <i class="caret ml-[3px] inline-block h-[1.05em] w-[2px] bg-white"></i>
      </span>
      <span class="sr-only">{services.map((s) => s.name).join(', ')}</span>
    </p>
  </div>

  <!-- etapa 1: logos de las plataformas con las que trabajamos (sobre la línea, a la derecha) -->
  <Partners />

  <!-- etapa 1: texto inferior (en móvil va encima del botón, sin la línea divisoria) -->
  <div
    data-foot-wrap
    class="pointer-events-none absolute inset-x-0 top-[77.7%] z-[2] flex items-start justify-between gap-8 px-(--gx) before:absolute before:left-0 before:top-0 before:h-px before:w-[33.3%] before:bg-white/25 after:absolute after:right-0 after:top-0 after:h-px after:w-[31%] after:bg-white/25 max-lg:before:hidden max-lg:after:hidden max-md:top-auto max-md:bottom-[84px]"
  >
    <p data-foot class="max-w-[34em] pt-7 max-md:pt-0 font-body text-[clamp(.8rem,.95vw,.95rem)] leading-snug text-[#a9afbb]">
      Agencia de marketing digital orientada a datos. Integramos estrategia, desarrollo, automatización y analítica en un sistema medible, donde cada acción se atribuye y se optimiza según su impacto en ingresos.
    </p>
  </div>

  <!-- en móvil el botón va debajo del texto, alineado a la izquierda -->
  <div data-actions class="absolute bottom-5 right-(--gx) z-[3] flex gap-1 max-md:left-(--gx) max-md:right-auto">
    <a href="/contacto" class="hbtn min-w-[190px] max-md:min-w-0 max-md:px-5">Agendar reunión</a>
    <a href="/contacto" class="hbtn w-11 px-0 max-md:hidden" aria-label="Contacto">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1"></path>
      </svg>
    </a>
  </div>

  <!-- etapa 2: galaxia -->
  <div data-panel="2" class="pointer-events-none invisible absolute inset-0 z-[2] opacity-0">
    <div class="absolute inset-x-(--gx) top-24 text-center">
      <h2 data-in class="display-xl">
        Lee a tu audiencia,<br />en movimiento
      </h2>
      <p data-in class="mx-auto mt-5 w-[min(34em,86vw)] font-body text-[clamp(.72rem,.85vw,.9rem)] leading-normal text-[#d4d8e0]">
        Cada campaña es una respuesta a tu público: clics, scroll y pausas, leídos en vivo y convertidos en decisiones.
      </p>
    </div>
    <Universe />
    <div
      class="absolute inset-x-0 bottom-0 grid h-[12%] grid-cols-4 border-t border-white/15 pl-[7vw] max-md:h-auto max-md:grid-cols-2 max-md:pl-0 max-md:pb-3"
    >
      {
        stats.map((s) => (
          <div data-in class="flex flex-col gap-[.15rem] border-l border-white/15 pl-[1.4vw] pt-[1.1vh] max-md:pl-3.5">
            <b class="font-display text-[clamp(1.3rem,1.9vw,2.2rem)] font-light leading-[1.1] tracking-[-0.02em]">{s.n}</b>
            <span class="font-body text-[clamp(.6rem,.7vw,.78rem)] leading-tight text-[#d4d8e0]">{s.l}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- etapa 3: cerebro (entender la intención del consumidor) -->
  <div data-panel="3" class="pointer-events-none invisible absolute inset-0 z-[2] opacity-0">
    <div class="absolute left-(--gx) top-24 max-w-[min(42vw,46rem)] max-lg:max-w-none max-lg:right-(--gx) max-md:top-[78px]">
      <h2 data-in class="font-accent text-[clamp(2rem,3.7vw,4.7rem)] font-bold uppercase leading-[1.04] tracking-[-0.02em]">
        Decodificamos<br />la intención de<br />tu <span class="text-secondary">consumidor.</span>
      </h2>
      <p data-in class="mt-10 max-md:mt-4 max-w-[27em] font-body text-[clamp(.8rem,.95vw,.95rem)] leading-snug text-[#a9afbb]">
        Nos reforzamos en la inteligencia artificial para combinar señales de comportamiento, datos first&#8209;party y modelos predictivos, y así anticipar qué necesita cada cliente y activarlo con el mensaje, el canal y el momento precisos.
      </p>
    </div>
    <div class="absolute bottom-[4%] right-(--gx) flex flex-col items-end gap-6 max-sm:gap-4">
      <AiTools />
      <h3 data-in class="display-xl text-right max-md:text-[2.2rem]">
        Predice, activa<br />y convierte.
      </h3>
    </div>
  </div>
</section>
