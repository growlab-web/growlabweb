---
import { services } from '../data/services.js';
const words = JSON.stringify(services.map((s) => s.name));
const stats = [
  { n: '250+', l: 'Proyectos entregados' },
  { n: '4,8x', l: 'ROAS medio en campañas' },
  { n: '12M€', l: 'Facturación generada' },
  { n: '98%', l: 'Clientes que repiten' },
];
---

<!--
  Hero fijo (pin) con tres etapas controladas por el scroll:
  casi-esfera  →  galaxia (panel 2)  →  cerebro (panel 3)
-->
<section
  id="top"
  data-hero
  data-pin
  class="relative h-screen min-h-[640px] overflow-hidden bg-[linear-gradient(175deg,#030814_0%,#000_45%,#000_100%)] [--gx:1.8vw]"
>
  <!-- degradados del fondo (se animan solos y con cada etapa) -->
  <div
    data-aurora="a"
    class="pointer-events-none absolute -left-[16vw] -top-[10vw] z-0 h-[26vw] w-[62vw] rotate-[-16deg] rounded-full bg-[radial-gradient(closest-side,#386fde,#1d3f94_55%,transparent)] opacity-50 blur-[80px] will-change-transform"
  >
  </div>
  <div
    data-aurora="b"
    class="pointer-events-none absolute -bottom-[8vw] -right-[14vw] z-0 h-[20vw] w-[78vw] rounded-full bg-[radial-gradient(closest-side,#5b8fe6,#26509f_55%,transparent)] opacity-40 blur-[80px] will-change-transform"
  >
  </div>
  <div
    data-aurora="c"
    class="pointer-events-none absolute -left-[6vw] top-[2vw] z-0 h-[34vw] w-[46vw] rounded-full bg-[radial-gradient(closest-side,#abe155,#4f7a1c_55%,transparent)] opacity-0 blur-[80px] will-change-transform"
  >
  </div>

  <!-- objeto 3D -->
  <canvas id="hero3d" class="absolute inset-0 z-[1] block h-full w-full" aria-hidden="true"></canvas>

  <!-- etapa 1: titular -->
  <div data-hero-title class="pointer-events-none relative z-[2] px-(--gx) pt-24">
    <h1 class="max-w-[min(36vw,38rem)] font-accent text-[clamp(2.2rem,3.9vw,4.7rem)] font-bold leading-[1.04] tracking-[-0.02em] max-md:max-w-none">
      <span data-line class="block">Crecimiento</span>
      <span data-line class="block">digital, medible</span>
      <span data-line class="block">y <span class="text-secondary">escalable.</span></span>
    </h1>
    <!-- servicios que se escriben y se borran uno tras otro -->
    <p data-foot class="mt-7 font-display font-light">
      <span class="mb-1 block font-body text-[.78rem] uppercase tracking-[.2em] text-white/50">Especialistas en</span>
      <span class="inline-flex items-center font-ui text-[clamp(1.35rem,2.1vw,2rem)] font-normal tracking-[-0.01em] text-white">
        <span data-typewriter data-words={words} aria-hidden="true">Performance &amp; Ads</span>
        <i class="caret ml-[3px] inline-block h-[1.05em] w-[2px] bg-white"></i>
      </span>
      <span class="sr-only">{services.map((s) => s.name).join(', ')}</span>
    </p>
  </div>

  <!-- etapa 1: textos inferiores -->
  <div
    data-foot-wrap
    class="pointer-events-none absolute inset-x-0 top-[77.7%] z-[2] flex items-start justify-between gap-8 px-(--gx) before:absolute before:left-0 before:top-0 before:h-px before:w-[33.3%] before:bg-white/25 after:absolute after:right-0 after:top-0 after:h-px after:w-[31%] after:bg-white/25 max-md:before:w-full max-md:after:hidden"
  >
    <p data-foot class="cap flex items-center gap-4 pt-7 tracking-[.01em]">
      <span class="inline-flex items-center gap-2 rounded-full border border-secondary/40 bg-secondary/10 px-3 py-1.5 font-accent text-[.62rem] font-bold uppercase tracking-[.16em] text-secondary">
        <i class="live-dot relative inline-block h-2 w-2 rounded-full bg-secondary"></i>En vivo
      </span>
      <span>5 marcas trabajando con nosotros</span>
    </p>
    <p data-foot class="max-w-[19.5em] pt-7 font-body text-[clamp(.75rem,.95vw,.95rem)] leading-snug text-[#eef0f4] max-md:hidden">
      Estrategia, performance y contenido que convierten tu presencia digital en clientes, afinados para sentirse vivos en cada clic.
    </p>
  </div>

  <div data-actions class="absolute bottom-5 right-(--gx) z-[3] flex gap-1">
    <a href="/contacto" class="hbtn min-w-[190px]">Enviar solicitud</a>
    <a href="/contacto" class="hbtn w-11 px-0" aria-label="Contacto">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1"></path>
      </svg>
    </a>
  </div>

  <!-- etapa 2: galaxia -->
  <div data-panel="2" class="pointer-events-none invisible absolute inset-0 z-[2] opacity-0">
    <h2 class="display-xl absolute inset-x-(--gx) top-24 text-center">
      Lee a tu audiencia,<br />en movimiento
    </h2>
    <p
      class="absolute bottom-[16%] left-1/2 w-[min(34em,86vw)] -translate-x-1/2 text-center font-body text-[clamp(.72rem,.85vw,.9rem)] leading-normal text-[#d4d8e0] max-md:bottom-[24%]"
    >
      Cada campaña es una respuesta a tu público: clics, scroll y pausas, leídos en vivo y convertidos en decisiones.
    </p>
    <div
      class="absolute inset-x-0 bottom-0 grid h-[12%] grid-cols-4 border-t border-white/15 pl-[7vw] max-md:h-auto max-md:grid-cols-2 max-md:pl-0 max-md:pb-3"
    >
      {
        stats.map((s) => (
          <div class="flex flex-col gap-[.15rem] border-l border-white/15 pl-[1.4vw] pt-[1.1vh] max-md:pl-3.5">
            <b class="font-display text-[clamp(1.3rem,1.9vw,2.2rem)] font-light leading-[1.1] tracking-[-0.02em]">{s.n}</b>
            <span class="font-body text-[clamp(.6rem,.7vw,.78rem)] leading-tight text-[#d4d8e0]">{s.l}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- etapa 3: cerebro (el titular de arriba vuelve a aparecer) -->
  <div data-panel="3" class="pointer-events-none invisible absolute inset-0 z-[2] opacity-0">
    <p class="cap absolute left-(--gx) top-[56%] max-w-[21em]">
      Cada decisión se mide, se prueba y se optimiza semana a semana.
    </p>
    <p class="cap absolute right-(--gx) top-[56%] max-w-[12em] max-md:hidden">
      Sin métricas vanidosas. Solo resultados que se ven en caja.
    </p>
    <h3 class="display-xl absolute bottom-[4%] right-(--gx) text-right max-md:text-[2.2rem]">
      Lee, aprende<br />y vende.
    </h3>
  </div>
</section>
