---
// Listado del blog (portada y páginas de categoría). Se pintan todos los artículos y el filtro por categoría funciona en la misma
// página, sin recargar: muestra los de la categoría, cambia el título y la dirección (/blog/categoria/…), y el botón «atrás» funciona.
// Cada dirección de categoría sigue existiendo como página propia, así que se puede compartir o abrir directamente.
import PostCard from './PostCard.astro';
import { blogCategories } from '../../data/blog.js';
import { getPosts } from '../../data/posts.js';
interface Props { eyebrow: string; title: string; text: string; current?: string }
const { eyebrow, title, text, current } = Astro.props;
const all = await getPosts();
const used = new Set(all.map((p) => p.data.category));
const cats = blogCategories.filter((c) => used.has(c.slug));            // sólo categorías con artículos
const visible = all.filter((p) => !current || p.data.category === current);
const featuredId = visible[0]?.id;
const chip = 'blog-chip gtm-blog-categoria rounded-full border px-4 py-2 font-ui text-[.88rem] transition-colors';
// textos de cada vista, para que el filtro pueda cambiar la cabecera sin recargar
const views = { '': { eyebrow: 'Blog', title: 'Ideas para crecer con datos', text: 'Guías prácticas, casos y aprendizajes sobre campañas, medición, SEO, ecommerce e inteligencia artificial, desde lo que vemos cada día con nuestros clientes.', doc: 'Blog · Marketing digital, datos y crecimiento · GrowLab' } };
cats.forEach((c) => { views[c.slug] = { eyebrow: 'Blog · Categoría', title: c.name, text: c.description, doc: `${c.name} · Blog · GrowLab` }; });
---

<section data-blog-list data-views={JSON.stringify(views)} class="relative z-[1] mx-auto max-w-[1240px] px-(--pad) pb-[12vh] pt-[clamp(130px,20vh,200px)]">
  <!-- Cabecera: el texto cambia con el filtro. Su alto se fija al de la vista más alta (lo mide el script), así al filtrar no se
       mueve nada de lo que hay debajo. -->
  <header data-reveal class="blog-head relative max-w-[760px]">
    <div data-blog-head class="blog-head__live">
      <p data-blog-eyebrow class="eyebrow">{eyebrow}</p>
      <h1 data-blog-title class="blog-head__title">{title}</h1>
      <p data-blog-text class="blog-head__text">{text}</p>
    </div>
  </header>

  {cats.length > 1 && (
    <nav data-reveal aria-label="Categorías del blog" class="mt-10 flex flex-wrap gap-2.5">
      <a href="/blog" data-cat="" id="blog-categoria-todas" aria-current={!current ? 'page' : undefined} class={chip}>Todo</a>
      {cats.map((c) => <a href={`/blog/categoria/${c.slug}`} data-cat={c.slug} id={`blog-categoria-${c.slug}`} aria-current={current === c.slug ? 'page' : undefined} class={chip}>{c.name}</a>)}
    </nav>
  )}

  {all.length === 0 ? (
    <div data-reveal class="mt-16 rounded-[24px] border border-white/10 bg-panel/70 p-10 text-center">
      <p class="font-display text-[1.3rem]">Muy pronto, nuevos artículos aquí.</p>
      <p class="mt-3 text-copy">Mientras tanto, cuéntanos qué necesitas: <a href="/contacto" class="text-secondary underline underline-offset-4">escríbenos</a>.</p>
    </div>
  ) : (
    <div data-blog-grid class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((p) => <div data-blog-item data-category={p.data.category} hidden={current ? p.data.category !== current : undefined} class:list={['contents']}><PostCard post={p} featured={p.id === featuredId} /></div>)}
    </div>
  )}
</section>

<style>
  /* todas las vistas usan exactamente los mismos tamaños de título y descripción */
  .blog-head__title { font-family: var(--font-display); font-weight: 300; line-height: 0.98; letter-spacing: -0.035em; font-size: clamp(2.2rem, 4.4vw, 4.4rem); }
  .blog-head__text { margin-top: 1.5rem; max-width: 56ch; font-family: var(--font-body); font-size: clamp(0.95rem, 1.15vw, 1.1rem); line-height: 1.65; color: var(--color-copy); }
  .blog-chip { transition: background-color 0.35s, border-color 0.35s, color 0.35s, transform 0.2s; }
  .blog-chip:active { transform: scale(0.95); }
  .blog-chip { border-color: rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.8); }
  .blog-chip:hover { border-color: #fff; }
  .blog-chip[aria-current='page'] { border-color: var(--color-secondary); background: var(--color-secondary); color: #000; }
</style>

<script>
  import { track } from '../../scripts/track.js';
  const list = document.querySelector<HTMLElement>('[data-blog-list]');
  if (list) {
    const views = JSON.parse(list.dataset.views || '{}');
    const items = [...list.querySelectorAll<HTMLElement>('[data-blog-item]')];
    const chips = [...list.querySelectorAll<HTMLAnchorElement>('.blog-chip')];
    const set = (sel: string, txt: string) => { const el = list.querySelector(sel); if (el) el.textContent = txt; };

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const head = list.querySelector<HTMLElement>('[data-blog-head]');
    const grid = list.querySelector<HTMLElement>('[data-blog-grid]');
    const ease = 'cubic-bezier(.2,.8,.2,1)';
    let busy: Promise<unknown> = Promise.resolve();

    // alto fijo de la cabecera = el de la vista más alta: se mide escribiendo cada vista en una copia invisible del mismo ancho
    function lockHeight() {
      if (!head) return;
      const probe = head.cloneNode(true) as HTMLElement;
      probe.removeAttribute('data-blog-head');
      Object.assign(probe.style, { position: 'absolute', visibility: 'hidden', pointerEvents: 'none', left: '0', top: '0', width: head.offsetWidth + 'px', minHeight: '0' });
      head.parentElement!.appendChild(probe);
      let max = 0;
      Object.values(views).forEach((v: any) => {
        probe.querySelector('[data-blog-eyebrow]')!.textContent = v.eyebrow;
        probe.querySelector('[data-blog-title]')!.textContent = v.title;
        probe.querySelector('[data-blog-text]')!.textContent = v.text;
        max = Math.max(max, probe.offsetHeight);
      });
      probe.remove();
      head.style.minHeight = max + 'px';
    }
    lockHeight();
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(lockHeight);
    let rt = 0; addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(lockHeight, 150); });

    // pinta la vista: textos, botón activo, tarjetas visibles y cuál es la destacada
    function apply(cat: string) {
      const v = views[cat] || views[''];
      set('[data-blog-eyebrow]', v.eyebrow); set('[data-blog-title]', v.title); set('[data-blog-text]', v.text);
      document.title = v.doc;
      chips.forEach((c) => { if (c.dataset.cat === cat) c.setAttribute('aria-current', 'page'); else c.removeAttribute('aria-current'); });
      let first = true;
      items.forEach((it) => {
        const on = !cat || it.dataset.category === cat;
        it.hidden = !on;
        it.querySelector('.post-card')?.classList.toggle('is-featured', on && first);
        if (on) first = false;
      });
    }

    // transición: la cabecera y las tarjetas salen (se desvanecen y bajan un poco), se cambia la vista y entran escalonadas;
    // la rejilla anima su alto para que lo de abajo (el pie) no salte de golpe
    function show(cat: string, animate: boolean) {
      if (!animate || reduce || !grid || !head) { apply(cat); return; }
      busy = busy.then(async () => {
        const out = [...items].filter((it) => !it.hidden).map((it) => it.querySelector<HTMLElement>('.post-card')).filter(Boolean) as HTMLElement[];
        const h0 = grid.offsetHeight;
        await Promise.all([
          head.animate([{ opacity: 1, transform: 'none', filter: 'blur(0)' }, { opacity: 0, transform: 'translateY(-10px)', filter: 'blur(6px)' }], { duration: 220, easing: 'ease-in', fill: 'forwards' }).finished,
          ...out.map((c, i) => c.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(16px) scale(.98)' }], { duration: 200, delay: i * 25, easing: 'ease-in', fill: 'forwards' }).finished),
        ]);
        apply(cat);
        out.forEach((c) => c.getAnimations().forEach((a) => a.cancel()));
        const h1 = grid.offsetHeight;
        if (h0 !== h1) grid.animate([{ height: h0 + 'px', overflow: 'hidden' }, { height: h1 + 'px', overflow: 'hidden' }], { duration: 380, easing: ease });
        head.getAnimations().forEach((a) => a.cancel());
        head.animate([{ opacity: 0, transform: 'translateY(12px)', filter: 'blur(6px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }], { duration: 420, easing: ease });
        const inn = [...items].filter((it) => !it.hidden).map((it) => it.querySelector<HTMLElement>('.post-card')).filter(Boolean) as HTMLElement[];
        inn.forEach((c, i) => c.animate([{ opacity: 0, transform: 'translateY(22px) scale(.98)' }, { opacity: 1, transform: 'none' }], { duration: 480, delay: 60 + i * 70, easing: ease, fill: 'backwards' }));
      });
    }

    chips.forEach((c) => c.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;   // abrir en otra pestaña sigue funcionando
      e.preventDefault();
      const cat = c.dataset.cat || '';
      if (c.getAttribute('aria-current') === 'page') return;
      show(cat, true);
      history.pushState({ cat }, '', c.getAttribute('href') || '/blog');
      track('blog_filter', { category: cat || 'todas' });
    }));
    // botón atrás / adelante del navegador
    addEventListener('popstate', () => {
      const m = location.pathname.match(/\/blog\/categoria\/([^/]+)/);
      show(m ? m[1] : '', true);
    });
  }
</script>
