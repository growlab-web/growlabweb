---
// Listado del blog (portada y páginas de categoría): cabecera, categorías, artículo destacado y rejilla
import PostCard from './PostCard.astro';
import { blogCategories } from '../../data/blog.js';
import { getPosts } from '../../data/posts.js';
interface Props { posts: any[]; eyebrow: string; title: string; text: string; current?: string }
const { posts, eyebrow, title, text, current } = Astro.props;
// sólo se muestran las categorías que ya tienen artículos (las vacías no tienen página)
const used = new Set((await getPosts()).map((p) => p.data.category));
const cats = blogCategories.filter((c) => used.has(c.slug));
const [first, ...rest] = posts;
const chip = 'rounded-full border px-4 py-2 font-ui text-[.88rem] transition-colors';
---

<section class="relative z-[1] mx-auto max-w-[1240px] px-(--pad) pb-[12vh] pt-[clamp(130px,20vh,200px)]">
  <header class="max-w-[760px]">
    <p data-reveal class="eyebrow">{eyebrow}</p>
    <h1 data-reveal class="display-xl !text-[clamp(2.2rem,4.4vw,4.4rem)]">{title}</h1>
    <p data-reveal class="mt-6 max-w-[56ch] font-body text-[clamp(.95rem,1.15vw,1.1rem)] leading-relaxed text-copy">{text}</p>
  </header>

  {cats.length > 1 && <nav data-reveal aria-label="Categorías del blog" class="mt-10 flex flex-wrap gap-2.5">
    <a href="/blog" id="blog-categoria-todas" aria-current={!current ? 'page' : undefined} class:list={[chip, 'gtm-blog-categoria', !current ? 'border-secondary bg-secondary text-black' : 'border-white/20 text-white/80 hover:border-white']}>Todo</a>
    {cats.map((c) => (
      <a href={`/blog/categoria/${c.slug}`} id={`blog-categoria-${c.slug}`} aria-current={current === c.slug ? 'page' : undefined} class:list={[chip, 'gtm-blog-categoria', current === c.slug ? 'border-secondary bg-secondary text-black' : 'border-white/20 text-white/80 hover:border-white']}>{c.name}</a>
    ))}
  </nav>}

  {posts.length === 0 ? (
    <div data-reveal class="mt-16 rounded-[24px] border border-white/10 bg-panel/70 p-10 text-center">
      <p class="font-display text-[1.3rem]">Muy pronto, nuevos artículos aquí.</p>
      <p class="mt-3 text-copy">Mientras tanto, cuéntanos qué necesitas: <a href="/contacto" class="text-secondary underline underline-offset-4">escríbenos</a>.</p>
    </div>
  ) : (
    <div class="mt-14 grid gap-6">
      <div data-reveal><PostCard post={first} featured /></div>
      {rest.length > 0 && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((p) => <div data-reveal><PostCard post={p} /></div>)}
        </div>
      )}
    </div>
  )}
</section>
