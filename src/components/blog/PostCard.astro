---
import { getCategory, formatDate, readingTime } from '../../data/blog.js';
interface Props { post: any; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, description, date, category, cover, coverAlt } = post.data;
const cat = getCategory(category);
const href = `/blog/${post.id}`;
---

<!-- la versión destacada (grande) depende de la clase is-featured, así el filtro del blog puede cambiar cuál es la primera sin recargar -->
<article data-post data-category={category} class:list={['post-card group relative flex flex-col overflow-hidden rounded-[24px] border border-white/10 bg-panel/80 transition-colors duration-300 hover:border-secondary', featured && 'is-featured']}>
  <div class="post-card__media relative aspect-[16/9] overflow-hidden bg-[#0d1322]">
    {cover
      ? <img src={cover} alt={coverAlt || title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      : <div class="grid h-full w-full place-items-center bg-[radial-gradient(circle_at_30%_30%,#1d3f94,transparent_60%),radial-gradient(circle_at_80%_80%,#1f8f68,transparent_55%)]"><span class="font-display text-[1.1rem] text-white/70">{cat?.name}</span></div>}
  </div>
  <div class="post-card__body flex flex-1 flex-col gap-3 p-6">
    <p class="font-ui text-[.78rem] uppercase tracking-[.12em] text-secondary">{cat?.name}</p>
    <p class="-mt-1 font-ui text-[.8rem] text-white/50"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min de lectura</p>
    <h2 class="post-card__title font-display text-[1.3rem] font-medium leading-[1.15] tracking-[-0.02em]">
      <a href={href} id={`blog-articulo-${post.id}`} class="gtm-blog-articulo after:absolute after:inset-0 after:content-['']">{title}</a>
    </h2>
    <p class="line-clamp-3 text-copy">{description}</p>
    <span class="mt-auto pt-2 font-ui text-[.9rem] text-white/80 transition-colors group-hover:text-secondary">Leer artículo →</span>
  </div>
</article>
