---
// Plataformas que orbitan la galaxia: cada herramienta es un "planeta" de un mismo universo (iconos de simple-icons, CC0).
import { siGooglesearchconsole, siGoogletagmanager, siMeta, siShopify, siGoogleads, siGoogleanalytics, siMailchimp, siTiktok } from 'simple-icons';

// Stape no está en simple-icons: isotipo de su logo oficial.
const stape = { path: 'M23 7L14 22L23 28V38H0V34L8 20L0 14V5H23V7Z', hex: 'ff6d34', viewBox: '-5 5 33 33' };

const inner = [
  { icon: siGoogletagmanager, name: 'Tag Manager' },
  { icon: siGoogleanalytics, name: 'Analytics' },
  { icon: siGooglesearchconsole, name: 'Search Console' },
  { icon: stape, name: 'Stape' },
];
const outer = [
  { icon: siShopify, name: 'Shopify' },
  { icon: siMeta, name: 'Meta Ads' },
  { icon: siGoogleads, name: 'Google Ads' },
  { icon: { ...siTiktok, hex: 'ffffff' }, name: 'TikTok Ads' },
  { icon: siMailchimp, name: 'Mailchimp' },
];
const rings = [inner, outer];
---

<div data-universe data-in class="pointer-events-none absolute left-1/2 top-[57%] z-[1] max-sm:top-[56%] h-0 w-0" aria-hidden="true">
  {
    rings.map((ring, r) =>
      ring.map((p, i) => (
        <span
          data-orbit
          data-ring={r}
          data-i={i}
          data-n={ring.length}
          class="absolute left-0 top-0 flex items-center gap-2 whitespace-nowrap rounded-full border border-white/25 bg-[#0b1226] py-2 pl-2.5 pr-4 font-ui text-[.95rem] text-white/90 shadow-[0_0_24px_rgba(56,111,222,.25)] will-change-transform max-sm:p-2"
        >
          <svg viewBox={'viewBox' in p.icon ? p.icon.viewBox : '0 0 24 24'} class="h-[22px] w-[22px] shrink-0" fill={`#${p.icon.hex}`}>
            <path d={p.icon.path} />
          </svg>
          <span class="max-sm:hidden">{p.name}</span>
          <i class="pointer-events-none absolute left-1/2 top-full h-7 w-px -translate-x-1/2 bg-gradient-to-b from-white/60 to-white/10"></i>
          <i class="pointer-events-none absolute left-1/2 top-full mt-7 h-[5px] w-[5px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white shadow-[0_0_8px_2px_rgba(255,255,255,.7)]"></i>
        </span>
      ))
    )
  }
</div>

<script>
  // Cada plataforma es un planeta del disco: ocupa un punto real de la galaxia y gira alrededor del núcleo al ritmo del polvo que tiene al lado
  // (hero3d.js da la velocidad a cada radio y proyecta el punto a pantalla). Las de delante se ven más grandes.
  // Siempre opacas: si no, las partículas se ven a través y no se leen.
  // Con el cursor encima crecen un poco (se calcula aquí, no con :hover, porque la posición y la escala las pone este script).
  type Spot = { x: number; y: number; depth: number };
  type Orbit = { t: number; unit: number; speed(r: number): number; project(r: number, th: number, out: Spot): Spot };
  const root = document.querySelector<HTMLElement>('[data-universe]');
  const canvas = document.querySelector<HTMLElement>('#hero3d');
  if (root && canvas) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-orbit]')];
    const angle = items.map((el) => (+el.dataset.i! / +el.dataset.n!) * Math.PI * 2 + +el.dataset.ring! * 0.6);   // cada una lleva su propio ángulo
    const panel = root.closest<HTMLElement>('[data-panel]');
    const spot: Spot = { x: 0, y: 0, depth: 0 };
    const size = items.map(() => ({ w: 0, h: 0 })), grow = items.map(() => 0);
    const measure = () => items.forEach((el, k) => { size[k].w = el.offsetWidth; size[k].h = el.offsetHeight; });
    measure();
    window.addEventListener('resize', measure);
    const mouse = { x: -1e4, y: -1e4 };
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      window.addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
      document.addEventListener('pointerleave', () => { mouse.x = mouse.y = -1e4; });
    }
    let last = -1, lastNow = performance.now();
    const frame = () => {
      requestAnimationFrame(frame);
      const g: Orbit | undefined = (window as any).__galaxyOrbit;
      if (!g) return;
      const dt = last < 0 ? 0 : g.t - last; last = g.t;                 // el tiempo es el de la galaxia: avanzan lo mismo que sus partículas aunque no se vean
      const now = performance.now(), ease = 1 - Math.exp(-(now - lastNow) / 110); lastNow = now;
      const hidden = !!panel && panel.style.visibility === 'hidden';   // fuera de su etapa solo se lleva la cuenta del ángulo
      const W = window.innerWidth, H = window.innerHeight;
      const phone = W < 520;
      const outer = phone ? W * 0.45 : Math.min(W * 0.38, H * 0.5);    // radio en píxeles; por delante la perspectiva lo acerca a las cifras de abajo
      const c = hidden ? null : canvas.getBoundingClientRect(), o = hidden ? null : root.getBoundingClientRect();
      items.forEach((el, k) => {
        const r = (outer * (el.dataset.ring === '0' ? (phone ? 0.48 : 0.52) : 1)) / g.unit;
        angle[k] += g.speed(r) * dt;
        if (!c || !o) return;
        g.project(r, angle[k], spot);
        const cx = c.left + spot.x, cy = c.top + spot.y, sc = 0.78 + spot.depth * 0.3;
        const over = Math.abs(mouse.x - cx) < (size[k].w * sc) / 2 + 4 && Math.abs(mouse.y - cy) < (size[k].h * sc) / 2 + 4;
        grow[k] += ((over ? 1 : 0) - grow[k]) * ease;
        el.style.transform = `translate(calc(${cx - o.left}px - 50%), calc(${cy - o.top}px - 50%)) scale(${sc * (1 + grow[k] * 0.12)})`;
        el.style.zIndex = String(Math.round(spot.depth * 10) + (over ? 20 : 0));     // la que se señala pasa por delante de sus vecinas
      });
    };
    requestAnimationFrame(frame);
  }
</script>
