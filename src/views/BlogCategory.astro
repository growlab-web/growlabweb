---
// Página de una categoría del blog en los dos idiomas: /blog/categoria/… y /en/blog/category/…
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BlogBackground from '../components/blog/BlogBackground.astro';
import BlogList from '../components/blog/BlogList.astro';
import { getCategoryFor } from '../data/blog.js';
import { site } from '../data/site.js';
import { useLang } from '../i18n.js';
interface Props { slug: string }
const { lang, t, href } = useLang(Astro);
const cat = getCategoryFor(Astro.props.slug, lang)!;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Blog', item: `${site.url}${href('/blog')}` },
  { '@type': 'ListItem', position: 2, name: cat.name, item: `${site.url}${href(`/blog/categoria/${cat.slug}`)}` },
] }];
---

<Layout title={t(`${cat.name}: artículos y guías | Blog de GrowLab`, `${cat.name}: articles and guides | GrowLab Blog`)} description={t(`${cat.description} Artículos y guías del equipo de GrowLab.`, `${cat.description} Articles and guides from the GrowLab team.`)} jsonld={jsonld}>
  <BlogBackground />
  <Nav />
  <main id="contenido" tabindex="-1" class="page-in relative z-[1]">
    <BlogList eyebrow={t('Blog · Categoría', 'Blog · Category')} title={cat.name} text={cat.description} current={cat.slug} />
  </main>
  <div class="relative z-[1]"><Footer seamless /></div>
</Layout>
