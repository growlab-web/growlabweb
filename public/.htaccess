# growlab.pe en cPanel (servidor LiteSpeed, compatible con las reglas de Apache). Este archivo se copia tal cual a la raíz del sitio (public_html) al hacer `npm run build`.

Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_dir.c>
  # las carpetas no añaden la barra final por su cuenta: de eso se encargan las reglas de abajo
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) seguridad: nadie puede abrir archivos ocultos (p. ej. el registro de la publicación automática, .ftp-deploy-sync-state.json)
  #    salvo /.well-known, que usa cPanel para renovar el certificado SSL; y el único PHP que se ejecuta es el del formulario:
  #    si alguien lograra subir otro .php (una «puerta trasera»), el servidor se negaría a ejecutarlo
  RewriteRule (^|/)\.(?!well-known/) - [F]
  RewriteCond %{REQUEST_URI} \.(php\d?|phtml|phar|pl|py|cgi|sh)$ [NC]
  RewriteCond %{REQUEST_URI} !^/api/contacto\.php$
  RewriteRule ^ - [F]

  # 0b) direcciones basura que dejó el uso anterior del dominio (spam del tipo /?j=… o /?items/…): «410, ya no existen»,
  #     para que Google las borre del índice y deje de rastrearlas. Los parámetros de campañas (utm_, gclid, fbclid…) no se tocan
  RewriteCond %{QUERY_STRING} (^|&)j=[a-z0-9]+ [NC,OR]
  RewriteCond %{QUERY_STRING} ^items/ [NC]
  RewriteRule ^ - [G]

  # 1) siempre https y sin www (sólo en el dominio real: no afecta a pruebas en otras direcciones)
  RewriteCond %{HTTP_HOST} ^(www\.)?growlab\.pe$ [NC]
  RewriteCond %{HTTPS}:%{HTTP_HOST} !^on:growlab\.pe$ [NC]
  RewriteRule ^ https://growlab.pe%{REQUEST_URI} [R=301,L]

  # 1b) los nombres de sitemap habituales (y los del WordPress anterior) llevan al sitemap real
  RewriteRule ^(sitemap_index|sitemap|wp-sitemap)\.xml$ /sitemap-index.xml [R=301,L]

  # 1c) direcciones del WordPress anterior (plantilla de demostración). Las que tienen equivalente en la web nueva llevan a él;
  #     el resto responde 410 («eliminada definitivamente»): Google las quita del índice antes que con un 404.
  RewriteRule ^contactanos/?$ /contacto [R=301,L]
  RewriteRule ^politica-de-proteccion-de-datos-personales/?$ /privacidad [R=301,L]
  RewriteRule ^portfolio/webdesign-relengcorp/?$ /portafolio/relengcorp [R=301,L]
  RewriteRule ^servicios/[^/]+/?$ /#servicios [R=301,NE,L]
  RewriteRule ^(layouts|portfolio|portfolio_group|services|tag|category|team|wp-content|wp-includes|wp-admin|feed|comments|author)(/.*)?$ - [G]
  RewriteRule ^blog/page/ - [G]
  RewriteRule ^(ai\-driven\-software\-solutions\-for\-data\-management|ai\-insights\-weekly\-unveiling\-the\-latest\-features|ai\-technologies|best\-practices\-for\-running\-an\-efficient\-helpdesk|best\-project\-management\-software\-for\-growing\-teams|blog\-portfolio|boost\-your\-rankings\-with\-expert\-seo\-services|build\-loyalty\-digital\-tools\-for\-customer\-communication|building\-a\-team\-of\-ai\-experts\-is\-the\-key\-to\-success|building\-a\-thriving\-startup\-strategies\-and\-benefits|business\-automation\-podcast|cart|checkout|cloud\-based\-software\-solutions\-for\-businesses|collaborative\-ai\-networks\-enhancing\-global\-data\-sharing|decoding\-success\-selecting\-a\-consulting\-business\-model|effective\-seo\-tips\-to\-build\-high\-quality\-backlinks|effective\-ways\-to\-boost\-your\-productivity\-level|essential\-skills\-to\-develop\-for\-a\-startup\-organization|faqs|get\-a\-quote|harnessing\-ai\-for\-predictive\-analytics|helpdesk|how\-ai\-networks\-are\-reshaping\-cybersecurity|how\-content\-marketing\-enhances\-seo\-results|how\-custom\-software\-can\-boost\-productivity|how\-digital\-agencies\-transform\-online\-presence|how\-to\-learn\-from\-real\-life\-seo\-success\-stories|my\-account|newsletter\-popups|our\-team|portfolio\-list\-waves|portfolio\-slider|portfolio\-stacked|pricing|quote\-post|seo\-services|seo\-strategies\-every\-business\-should\-adopt|service\-plus|shopify\-en\-wordpress|software\-solutions|startup|streamline\-operations\-with\-innovative\-software\-solutions|technical\-seo\-audits\-the\-foundation\-of\-online\-success|the\-power\-of\-ai\-networks\-in\-modern\-computing|the\-role\-of\-digital\-agencies\-in\-startup\-growth|typography|understanding\-neural\-networks\-and\-deep\-learning|why\-networking\-is\-crucial\-for\-startup\-success|wishlist\-page)/?$ - [G]

  # 2) la antigua página de servicios es ahora una sección del inicio
  RewriteRule ^servicios/?$ /#servicios [R=301,NE,L]

  # 3) direcciones sin barra final: /nosotros/ → /nosotros
  RewriteCond %{THE_REQUEST} \s/([^?\s]*[^/?\s])/+(\?[^\s]*)?\s
  RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
  RewriteRule ^ /%1 [R=301,L]

  # 4) /nosotros se sirve desde /nosotros/index.html, sin redirección
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]
</IfModule>

# caché: las páginas se piden siempre de nuevo y las imágenes duran un mes (la carpeta /_astro tiene su propia regla, en /_astro/.htaccess)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # seguridad: sólo https (1 año), ninguna web ajena puede mostrar ésta dentro de un marco (evita engaños de «clic oculto»),
  # sin acceso a cámara, micrófono, ubicación ni pagos, y sin plugins ni formularios que envíen datos a otros dominios
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/xml application/javascript application/json image/svg+xml
</IfModule>
